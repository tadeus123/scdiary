{
  "name": "scdiary",
  "version": "1.0.0",
  "description": "A minimalist digital diary website",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "build:cause": "npm run build --prefix cause",
    "postinstall": "npm install --prefix aircart-addon",
    "build:aircart": "npm run build --prefix aircart-addon",
    "aircart": "npm run start --prefix aircart-addon",
    "aircart:dev": "npm run dev --prefix aircart-addon",
    "generate:favicon": "powershell -ExecutionPolicy Bypass -File server/scripts/generate-favicon.ps1",
    "verify:favicon": "node server/scripts/verify-favicon.js",
    "restore:favicon": "node server/scripts/restore-favicon.js",
    "test:airsup": "node airsup/a2a.test.js && node airsup/call.test.js && node airsup/call-state.test.js && node airsup/knowledge.test.js && node airsup/prompt.test.js && node airsup/mcp.test.js && node airsup/questions.test.js"
  },
  "keywords": [
    "diary",
    "blog",
    "personal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.79.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "marked": "^9.1.6",
    "multer": "^2.0.2",
    "pg": "^8.18.0"
  }
}
