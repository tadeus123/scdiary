<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
  <% if (typeof testCss === 'string' && testCss) { %>
  <style><%- testCss %></style>
  <% } else { %>
  <link rel="stylesheet" href="/airsup/china/test/test-chat.css?v=4">
  <% } %>
</head>
<body class="cn-body cn-test" data-lang="<%= lang %>" data-logged-in="<%= loggedIn ? '1' : '0' %>">
  <header class="cn-test-top">
    <div class="cn-test-brand">
      <a href="/airsup/china/test">Airsup</a>
      <span class="cn-test-pill"><%= lang === 'en' ? 'Test' : '测试' %></span>
    </div>
    <div class="cn-test-actions" id="cn-test-actions">
      <% if (loggedIn) { %>
        <span class="cn-test-who" id="cn-test-who" title="<%= companyLabel %>"><%= companyLabel %></span>
        <button type="button" class="cn-btn-ghost" id="cn-test-logout"><%= lang === 'en' ? 'Log out' : '退出' %></button>
      <% } else { %>
        <button type="button" class="cn-btn" id="cn-test-login"><%= lang === 'en' ? 'Log in' : '登录' %></button>
      <% } %>
      <a class="cn-lang" href="/airsup/china/lang/<%= otherLang %>?next=<%= encodeURIComponent('/airsup/china/test') %>">
        <%= t('other_lang') %>
      </a>
    </div>
  </header>

  <div class="cn-test-stage">
    <section class="cn-test-web-pane" aria-label="<%= lang === 'en' ? 'Company endpoint web' : '公司端点网' %>">
      <div class="cn-test-web-head">
        <div>
          <h1><%= lang === 'en' ? 'Endpoint web' : '端点网' %></h1>
        </div>
        <div class="cn-test-reach">
          <div class="cn-test-reach-label"><%= lang === 'en' ? 'Reach' : '可达' %></div>
          <div class="cn-test-reach-value" id="cn-test-reach">10<span>/100</span></div>
          <svg class="cn-test-spark" id="cn-test-spark" viewBox="0 0 120 28" aria-hidden="true"></svg>
        </div>
      </div>
      <p class="cn-test-link-hint" id="cn-test-link-hint"><%= lang === 'en' ? 'Click two nodes to connect them' : '点两个节点，把它们连上' %></p>
      <div class="cn-test-canvas-wrap">
        <svg class="cn-test-canvas" id="cn-test-canvas" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet"></svg>
      </div>
    </section>

    <section class="cn-test-chat-pane" aria-label="<%= lang === 'en' ? 'Feed the web' : '喂养端点网' %>">
      <div class="cn-test-thread" id="cn-test-thread" aria-live="polite"></div>
      <div class="cn-test-composer-wrap">
        <form class="cn-test-composer" id="cn-test-form">
          <div class="cn-test-pending" id="cn-test-pending"></div>
          <div class="cn-test-row">
            <label class="cn-test-attach" title="<%= lang === 'en' ? 'Attach files' : '上传文件' %>">
              <input type="file" id="cn-test-files" multiple accept=".pdf,.xlsx,.xls,.zip,.csv,.txt,application/pdf,application/zip,image/*">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M21.4 11.6 12.1 20.9a5.2 5.2 0 0 1-7.4-7.4l9.9-9.9a3.5 3.5 0 0 1 4.9 4.9l-9.2 9.2a1.7 1.7 0 1 1-2.4-2.4l8.1-8.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </label>
            <textarea class="cn-test-input" id="cn-test-input" rows="1" placeholder="<%= lang === 'en' ? 'Drop a note, URL, or idea…' : '丢一段说明、网址或想法…' %>"></textarea>
            <button class="cn-test-send" id="cn-test-send" type="submit" aria-label="<%= lang === 'en' ? 'Send' : '发送' %>">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </form>
        <p class="cn-test-hint">
          <%= lang === 'en' ? 'Concept · ' : '概念 · ' %><a href="/airsup/china"><%= lang === 'en' ? 'Live' : '正式版' %></a>
        </p>
      </div>
    </section>
  </div>

  <script>
  (function () {
    var lang = document.body.getAttribute('data-lang') || 'zh';
    var chatKey = 'airsup_china_test_chat_v3';
    var webKey = 'airsup_china_test_web_v3';
    var thread = document.getElementById('cn-test-thread');
    var form = document.getElementById('cn-test-form');
    var input = document.getElementById('cn-test-input');
    var fileInput = document.getElementById('cn-test-files');
    var pendingEl = document.getElementById('cn-test-pending');
    var sendBtn = document.getElementById('cn-test-send');
    var actionsEl = document.getElementById('cn-test-actions');
    var canvas = document.getElementById('cn-test-canvas');
    var spark = document.getElementById('cn-test-spark');
    var reachEl = document.getElementById('cn-test-reach');
    var linkHint = document.getElementById('cn-test-link-hint');
    var welcome = <%- JSON.stringify(welcome) %>;
    var layout = <%- JSON.stringify(layoutPositions) %>;
    var initialWeb = <%- JSON.stringify(initialWeb) %>;
    var pendingFiles = [];
    var busy = false;
    var typingRow = null;
    var pulseIds = [];
    var selectedNode = null;

    function loadJson(key, fallback) {
      try {
        var raw = localStorage.getItem(key);
        if (!raw) return fallback;
        return JSON.parse(raw);
      } catch (e) {
        return fallback;
      }
    }

    function saveJson(key, value) {
      try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) {}
    }

    function esc(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function linkify(text) {
      return esc(text).replace(/(https?:\/\/[^\s<]+)/g, function (url) {
        return '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + url + '</a>';
      });
    }

    function formatSize(n) {
      n = Number(n) || 0;
      if (n < 1024) return n + ' B';
      if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
      return (n / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function fileExt(name) {
      var m = String(name || '').match(/\.([a-z0-9]+)$/i);
      return (m ? m[1] : 'FILE').toUpperCase().slice(0, 4);
    }

    function renderFiles(files) {
      if (!files || !files.length) return '';
      return '<div class="cn-test-files">' + files.map(function (f) {
        return '<div class="cn-test-file-card">'
          + '<span class="cn-test-file-ico">' + esc(fileExt(f.name)) + '</span>'
          + '<span class="cn-test-file-meta">'
          + '<span class="cn-test-file-name">' + esc(f.name || 'file') + '</span>'
          + (f.size ? '<span class="cn-test-file-size">' + esc(formatSize(f.size)) + '</span>' : '')
          + '</span></div>';
      }).join('') + '</div>';
    }

    function scrollChat() {
      requestAnimationFrame(function () {
        thread.scrollTop = thread.scrollHeight + 120;
      });
    }

    function appendBubble(role, content, files, opts) {
      opts = opts || {};
      var row = document.createElement('div');
      row.className = 'cn-test-msg is-' + (role === 'user' ? 'user' : 'assistant');
      if (opts.typing) row.classList.add('is-typing');
      var avatar = document.createElement('div');
      avatar.className = 'cn-test-avatar';
      avatar.textContent = role === 'user' ? 'U' : 'A';
      var bubble = document.createElement('div');
      bubble.className = 'cn-test-bubble';
      var hasText = Boolean(content && String(content).trim());
      if (!hasText && files && files.length) bubble.classList.add('is-files-only');
      if (opts.typing) {
        bubble.innerHTML = '<span class="cn-test-dots"><span></span><span></span><span></span></span>';
      } else {
        var html = '';
        if (hasText) html += '<div class="cn-test-text">' + (role === 'assistant' ? linkify(content) : esc(content)) + '</div>';
        html += renderFiles(files);
        bubble.innerHTML = html;
      }
      row.appendChild(avatar);
      row.appendChild(bubble);
      thread.appendChild(row);
      scrollChat();
      return row;
    }

    function paintChat(messages) {
      thread.innerHTML = '';
      messages.forEach(function (m) {
        appendBubble(m.role, m.content, m.files);
      });
    }

    function nodeRadius(node) {
      if (node.id === 'core') return 6.2 + (node.strength || 0) * 1.4;
      return 2.4 + (node.strength || 0) * 3.2;
    }

    function curvePath(a, b, bend) {
      var mx = (a.x + b.x) / 2;
      var my = (a.y + b.y) / 2;
      var dx = b.x - a.x;
      var dy = b.y - a.y;
      var len = Math.sqrt(dx * dx + dy * dy) || 1;
      var mag = (bend == null ? 1 : bend) * Math.min(9, len * 0.2);
      var cx = mx + (-dy / len) * mag;
      var cy = my + (dx / len) * mag;
      return 'M ' + a.x + ' ' + a.y + ' Q ' + cx.toFixed(2) + ' ' + cy.toFixed(2) + ' ' + b.x + ' ' + b.y;
    }

    function edgeBend(from, to) {
      var seed = (String(from) + String(to)).length;
      return (seed % 2 === 0 ? 1 : -1) * (0.7 + (seed % 5) * 0.12);
    }

    function renderWeb(web) {
      var nodes = web.nodes || {};
      var baseEdges = web.edges || [];
      var custom = web.customLinks || [];
      var allEdges = baseEdges.concat(custom.map(function (e) {
        return { from: e.from, to: e.to, kind: 'custom' };
      }));

      var edgeHtml = allEdges.map(function (e) {
        var a = layout[e.from];
        var b = layout[e.to];
        if (!a || !b) return '';
        var sa = nodes[e.from] ? nodes[e.from].strength : 0;
        var sb = nodes[e.to] ? nodes[e.to].strength : 0;
        var live = sa > 0.15 && sb > 0.15;
        var cls = 'cn-test-edge'
          + (e.kind === 'custom' ? ' is-custom' : '')
          + (live || e.kind === 'custom' ? ' is-live' : '');
        var preview = selectedNode && (
          (selectedNode === e.from || selectedNode === e.to) ? '' : ''
        );
        void preview;
        return '<path class="' + cls + '" d="' + curvePath(a, b, edgeBend(e.from, e.to)) + '"></path>';
      }).join('');

      if (selectedNode && layout[selectedNode]) {
        // soft preview ring already via selected class
      }

      var nodeHtml = Object.keys(layout).map(function (id) {
        var pos = layout[id];
        var node = nodes[id] || { id: id, label: id, strength: 0 };
        var on = node.strength > 0.15 || id === 'core';
        var pulse = pulseIds.indexOf(id) >= 0 ? ' is-pulse' : '';
        var core = id === 'core' ? ' is-core' : '';
        var sel = selectedNode === id ? ' is-selected' : '';
        var r = nodeRadius(node);
        var halo = Math.max(r + 1.6, r * 1.35);
        var below = pos.y >= 52;
        var labelY = below ? (pos.y + r + 3.6) : (pos.y - r - 1.8);
        var short = String(node.label || '');
        return '<g class="cn-test-node' + (on ? ' is-on' : '') + core + pulse + sel + '" data-id="' + id + '">'
          + '<circle class="halo" cx="' + pos.x + '" cy="' + pos.y + '" r="' + halo.toFixed(2) + '"></circle>'
          + '<circle class="core-dot" cx="' + pos.x + '" cy="' + pos.y + '" r="' + r.toFixed(2) + '"></circle>'
          + '<text x="' + pos.x + '" y="' + labelY.toFixed(2) + '">' + esc(short) + '</text>'
          + '</g>';
      }).join('');

      canvas.innerHTML = edgeHtml + nodeHtml;
      reachEl.innerHTML = String(web.reach || 10) + '<span>/100</span>';
      renderSpark(web.reachHistory || [web.reach || 10]);
      bindGraphClicks();
      updateLinkHint();
    }

    function renderSpark(history) {
      var vals = (history || [10]).map(function (n) { return Number(n) || 0; });
      if (vals.length < 2) vals = [vals[0] || 10, vals[0] || 10];
      var min = Math.min.apply(null, vals.concat([0]));
      var max = Math.max.apply(null, vals.concat([20]));
      if (max - min < 8) max = min + 8;
      var w = 120;
      var h = 28;
      var pts = vals.map(function (v, i) {
        var x = (i / (vals.length - 1)) * (w - 4) + 2;
        var y = h - 3 - ((v - min) / (max - min)) * (h - 8);
        return x.toFixed(1) + ',' + y.toFixed(1);
      }).join(' ');
      spark.innerHTML = '<polyline fill="none" stroke="#7a1e2b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" points="' + pts + '"></polyline>';
    }

    function updateLinkHint() {
      if (!linkHint) return;
      if (!selectedNode) {
        linkHint.textContent = lang === 'en' ? 'Click two nodes to connect them' : '点两个节点，把它们连上';
        return;
      }
      var label = (web.nodes[selectedNode] && web.nodes[selectedNode].label) || selectedNode;
      linkHint.textContent = lang === 'en'
        ? ('Selected “' + label + '” — click another node')
        : ('已选「' + label + '」— 再点另一个节点');
    }

    function bindGraphClicks() {
      canvas.querySelectorAll('.cn-test-node').forEach(function (g) {
        g.onclick = function (ev) {
          ev.preventDefault();
          var id = g.getAttribute('data-id');
          if (!id) return;
          if (!selectedNode) {
            selectedNode = id;
            renderWeb(web);
            return;
          }
          if (selectedNode === id) {
            selectedNode = null;
            renderWeb(web);
            return;
          }
          var from = selectedNode;
          var to = id;
          selectedNode = null;
          createLink(from, to);
        };
      });
    }

    async function createLink(from, to) {
      try {
        var res = await fetch('/airsup/china/test/api/link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ from: from, to: to, web: web }),
        });
        var data = await res.json().catch(function () { return {}; });
        if (data.web) {
          pulseIds = [from, to];
          web = data.web;
          saveJson(webKey, web);
          renderWeb(web);
          setTimeout(function () { pulseIds = []; renderWeb(web); }, 800);
          var note = lang === 'en'
            ? ('Linked. Reach ' + web.reach + '.')
            : ('已连接。可达 ' + web.reach + '。');
          messages.push({ role: 'assistant', content: note, at: Date.now() });
          saveJson(chatKey, messages);
          appendBubble('assistant', note);
        } else {
          renderWeb(web);
        }
      } catch (e) {
        renderWeb(web);
      }
    }

    function ensureWelcome(messages) {
      if (messages.length) return messages;
      var boot = [{ role: 'assistant', content: welcome, at: Date.now() }];
      saveJson(chatKey, boot);
      return boot;
    }

    function renderPending() {
      pendingEl.innerHTML = pendingFiles.map(function (f, i) {
        return '<div class="cn-test-file-card" data-i="' + i + '">'
          + '<span class="cn-test-file-ico">' + esc(fileExt(f.name)) + '</span>'
          + '<span class="cn-test-file-meta">'
          + '<span class="cn-test-file-name">' + esc(f.name) + '</span>'
          + '<span class="cn-test-file-size">' + esc(formatSize(f.size)) + '</span>'
          + '</span></div>';
      }).join('');
      pendingEl.querySelectorAll('[data-i]').forEach(function (chip) {
        chip.addEventListener('click', function () {
          pendingFiles.splice(Number(chip.getAttribute('data-i')), 1);
          renderPending();
        });
      });
    }

    function autosize() {
      input.style.height = 'auto';
      input.style.height = Math.min(120, input.scrollHeight) + 'px';
    }

    function bindAuthButtons() {
      var loginBtn = document.getElementById('cn-test-login');
      var logoutBtn = document.getElementById('cn-test-logout');
      if (loginBtn) {
        loginBtn.addEventListener('click', async function () {
          loginBtn.disabled = true;
          try {
            var res = await fetch('/airsup/china/test/api/login-demo', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: '{}',
            });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok) throw new Error('login');
            setLoggedIn(true, data.company && data.company.name);
            var note = lang === 'en'
              ? 'Logged in. Keep feeding the same web — progress stays with the company.'
              : '已登录。继续喂同一张网 — 进展会挂在公司下。';
            messages.push({ role: 'assistant', content: note, at: Date.now() });
            saveJson(chatKey, messages);
            appendBubble('assistant', note);
          } catch (e) {
            alert(lang === 'en' ? 'Demo login failed.' : '演示登录失败。');
          } finally {
            loginBtn.disabled = false;
          }
        });
      }
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async function () {
          try {
            await fetch('/airsup/china/test/api/logout', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: '{}',
            });
          } catch (e) {}
          setLoggedIn(false, '');
        });
      }
    }

    function setLoggedIn(on, name) {
      document.body.setAttribute('data-logged-in', on ? '1' : '0');
      var langLink = actionsEl.querySelector('.cn-lang');
      var langHtml = langLink ? langLink.outerHTML : '';
      if (on) {
        actionsEl.innerHTML =
          '<span class="cn-test-who" id="cn-test-who" title="' + esc(name || '') + '">' + esc(name || '') + '</span>'
          + '<button type="button" class="cn-btn-ghost" id="cn-test-logout">' + (lang === 'en' ? 'Log out' : '退出') + '</button>'
          + langHtml;
      } else {
        actionsEl.innerHTML =
          '<button type="button" class="cn-btn" id="cn-test-login">' + (lang === 'en' ? 'Log in' : '登录') + '</button>'
          + langHtml;
      }
      bindAuthButtons();
    }

    var web = loadJson(webKey, initialWeb) || initialWeb;
    var messages = ensureWelcome(loadJson(chatKey, []) || []);
    renderWeb(web);
    paintChat(messages);
    bindAuthButtons();

    fileInput.addEventListener('change', function () {
      Array.prototype.slice.call(fileInput.files || []).forEach(function (f) {
        pendingFiles.push(f);
      });
      fileInput.value = '';
      renderPending();
    });

    input.addEventListener('input', autosize);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (busy) return;
      var text = String(input.value || '').trim();
      if (!text && !pendingFiles.length) return;

      busy = true;
      sendBtn.disabled = true;
      var filesSnap = pendingFiles.slice();
      pendingFiles = [];
      renderPending();
      input.value = '';
      autosize();

      var userMsg = {
        role: 'user',
        content: text,
        files: filesSnap.map(function (f) { return { name: f.name, size: f.size }; }),
        at: Date.now(),
      };
      messages.push(userMsg);
      saveJson(chatKey, messages);
      appendBubble('user', userMsg.content, userMsg.files);
      typingRow = appendBubble('assistant', '', null, { typing: true });

      try {
        var body = new FormData();
        body.append('message', text);
        body.append('history', JSON.stringify(messages.slice(0, -1).map(function (m) {
          return { role: m.role, content: m.content || (m.files && m.files.length ? '[file upload]' : '') };
        })));
        body.append('web', JSON.stringify(web));
        filesSnap.forEach(function (f) { body.append('files', f); });

        var res = await fetch('/airsup/china/test/api/chat', {
          method: 'POST',
          body: body,
          credentials: 'same-origin',
        });
        var data = await res.json().catch(function () { return {}; });
        if (typingRow && typingRow.parentNode) typingRow.parentNode.removeChild(typingRow);
        typingRow = null;

        if (data.web) {
          pulseIds = (data.signals || []).map(function (s) { return s.node; });
          web = data.web;
          saveJson(webKey, web);
          renderWeb(web);
          setTimeout(function () { pulseIds = []; renderWeb(web); }, 900);
        }

        var replyText = res.ok
          ? (data.reply || '')
          : (lang === 'en' ? 'Something went wrong. Try again.' : '发送失败，请稍后再试。');
        messages.push({ role: 'assistant', content: replyText, at: Date.now() });
        saveJson(chatKey, messages);
        appendBubble('assistant', replyText);
      } catch (err) {
        if (typingRow && typingRow.parentNode) typingRow.parentNode.removeChild(typingRow);
        typingRow = null;
        var fail = lang === 'en' ? 'Network error. Try again.' : '网络错误，请重试。';
        messages.push({ role: 'assistant', content: fail, at: Date.now() });
        saveJson(chatKey, messages);
        appendBubble('assistant', fail);
      } finally {
        busy = false;
        sendBtn.disabled = false;
        input.focus();
      }
    });
  })();
  </script>
</body>
</html>
