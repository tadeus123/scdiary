<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
  <script src="https://unpkg.com/vis-network@10.1.2/standalone/umd/vis-network.min.js"></script>
  <% if (typeof testCss === 'string' && testCss) { %>
  <style><%- testCss %></style>
  <% } else { %>
  <link rel="stylesheet" href="/airsup/china/test/test-chat.css?v=9">
  <% } %>
</head>
<body
  class="cn-body cn-test<%= typeof boardFirst !== 'undefined' && boardFirst ? ' cn-test-board-first cn-test-has-board' : (typeof board !== 'undefined' && board ? ' cn-test-has-board' : '') %>"
  data-lang="<%= lang %>"
  data-logged-in="<%= loggedIn ? '1' : '0' %>"
  data-onboard-step="<%= (typeof boardFirst !== 'undefined' && boardFirst) ? 'live' : ((onboard && onboard.step) || 'site') %>"
  data-board-first="<%= typeof boardFirst !== 'undefined' && boardFirst ? '1' : '0' %>"
  data-using-memory="<%= usingMemory ? '1' : '0' %>"
  data-demo="0"
  data-auto="0"
>
  <header class="cn-test-top">
    <div class="cn-test-brand">
      <a href="/airsup/china/test">Airsup</a>
    </div>
    <div class="cn-test-actions" id="cn-test-actions">
      <% if (loggedIn) { %>
        <span class="cn-test-who" id="cn-test-who" title="<%= companyLabel %>"><%= companyLabel %></span>
        <button type="button" class="cn-btn-ghost" id="cn-test-logout"><%= lang === 'en' ? 'Log out' : '退出' %></button>
      <% } else { %>
        <button type="button" class="cn-btn" id="cn-test-login"><%= lang === 'en' ? 'Log in' : '登录' %></button>
      <% } %>
      <a class="cn-lang" href="/airsup/china/lang/<%= otherLang %>?next=<%= encodeURIComponent('/airsup/china/test') %>">
        <%= t('other_lang') %>
      </a>
    </div>
  </header>

  <div class="cn-test-reach-float" aria-hidden="true" hidden>
    <div class="n" id="cn-test-reach">0<span>/100</span></div>
    <svg class="cn-test-spark" id="cn-test-spark" viewBox="0 0 72 14"></svg>
  </div>

  <aside class="cn-test-onboard" id="cn-test-onboard" aria-label="<%= lang === 'en' ? 'Factory onboarding' : '工厂上线' %>" hidden>
    <div class="cn-test-onboard-card">
      <p class="cn-test-onboard-kicker" id="cn-ob-kicker"></p>
      <h1 class="cn-test-onboard-title" id="cn-ob-title"></h1>
      <p class="cn-test-onboard-lead" id="cn-ob-lead"></p>
      <div class="cn-test-onboard-msg" id="cn-ob-msg" role="status"></div>
      <div class="cn-test-onboard-preview" id="cn-ob-preview" hidden></div>
      <ul class="cn-test-onboard-gaps" id="cn-ob-gaps" hidden></ul>

      <div class="cn-ob-step" data-step="site" id="cn-ob-step-site">
        <label for="cn-ob-website"><%= lang === 'en' ? 'Company website' : '公司网站' %></label>
        <input type="url" id="cn-ob-website" autocomplete="url" placeholder="https://">
        <button type="button" class="cn-btn cn-ob-primary" id="cn-ob-continue-site"><%= lang === 'en' ? 'Continue' : '继续' %></button>
      </div>

      <div class="cn-ob-step" data-step="email" id="cn-ob-step-email" hidden>
        <label for="cn-ob-email"><%= lang === 'en' ? 'Work email' : '工作邮箱' %></label>
        <input type="email" id="cn-ob-email" autocomplete="email" placeholder="you@factory.com">
        <label for="cn-ob-contact"><%= lang === 'en' ? 'Contact name' : '联系人' %></label>
        <input type="text" id="cn-ob-contact" autocomplete="name" placeholder="<%= lang === 'en' ? 'Name' : '姓名' %>">
        <label for="cn-ob-city"><%= lang === 'en' ? 'City' : '城市' %></label>
        <select id="cn-ob-city">
          <% (typeof cities !== 'undefined' && cities ? cities : [{ id: 'shenzhen', zh: '深圳', en: 'Shenzhen' }, { id: 'dongguan', zh: '东莞', en: 'Dongguan' }, { id: 'other', zh: '其他', en: 'Other' }]).forEach(function (c) { %>
            <option value="<%= c.id %>" <%= c.id === 'shenzhen' ? 'selected' : '' %>><%= lang === 'en' ? c.en : c.zh %></option>
          <% }) %>
        </select>
        <button type="button" class="cn-btn cn-ob-primary" id="cn-ob-continue-email"><%= lang === 'en' ? 'Send verify link' : '发送验证链接' %></button>
      </div>

      <div class="cn-ob-step" data-step="verify" id="cn-ob-step-verify" hidden>
        <p class="cn-ob-check" id="cn-ob-check-copy"></p>
        <a class="cn-btn cn-ob-primary cn-ob-verify-link" id="cn-ob-verify-now" href="#" hidden>
          <%= lang === 'en' ? 'Verify now' : '立即验证' %>
        </a>
        <button type="button" class="cn-btn-ghost" id="cn-ob-resend" style="margin-top:0.55rem">
          <%= lang === 'en' ? 'Resend link' : '重发链接' %>
        </button>
      </div>

      <div class="cn-ob-step" data-step="fields" id="cn-ob-step-fields" hidden>
        <label for="cn-ob-wechat"><%= lang === 'en' ? 'WeChat ID' : '微信号' %></label>
        <input type="text" id="cn-ob-wechat" autocomplete="off" placeholder="wechat_id">
        <label for="cn-ob-sample"><%= lang === 'en' ? 'Sample / fastest lead you stand behind' : '样品 / 你能承诺的最快交期' %></label>
        <input type="text" id="cn-ob-sample" placeholder="<%= lang === 'en' ? 'e.g. samples in 5 days' : '例如：样品 5 天' %>">
        <label for="cn-ob-flex"><%= lang === 'en' ? 'Flexibility' : '灵活度' %></label>
        <select id="cn-ob-flex">
          <option value="strict"><%= lang === 'en' ? 'Strict' : '严格' %></option>
          <option value="normal" selected><%= lang === 'en' ? 'Normal' : '正常' %></option>
          <option value="creative"><%= lang === 'en' ? 'Creative' : '灵活' %></option>
        </select>
        <label for="cn-ob-contact-fields"><%= lang === 'en' ? 'Contact name' : '联系人' %></label>
        <input type="text" id="cn-ob-contact-fields" autocomplete="name">
        <button type="button" class="cn-btn cn-ob-primary" id="cn-ob-publish"><%= lang === 'en' ? 'Publish' : '上线' %></button>
      </div>

      <div class="cn-ob-step" data-step="live" id="cn-ob-step-live" hidden>
        <p class="cn-ob-live" id="cn-ob-live-copy"></p>
      </div>
    </div>
  </aside>

  <div id="cn-test-network"></div>
  <div class="cn-test-empty<%= typeof board !== 'undefined' && board ? ' is-gone' : '' %>" id="cn-test-empty" <%= typeof board !== 'undefined' && board ? 'hidden' : '' %>>
    <p><%= lang === 'en' ? 'Empty web. Drop a quote, site, or scrap — nodes appear and link.' : '空网。丢报价、网站或碎片 — 节点会出现并连上。' %></p>
  </div>

  <div class="cn-test-details hidden" id="cn-test-details">
    <button type="button" class="cn-test-details-close" id="cn-test-details-close" aria-label="Close">✕</button>
    <p class="kind" id="cn-test-details-kind"></p>
    <h2 id="cn-test-details-title"></h2>
    <p class="body" id="cn-test-details-body"></p>
  </div>

  <div class="cn-test-toast" id="cn-test-toast" role="status"></div>

  <section class="cn-test-board is-ready" id="cn-test-board" aria-label="<%= lang === 'en' ? 'Supplier board' : '供应商看板' %>">
    <div class="cn-test-board-main">
      <p class="cn-test-board-rate-label"><%= lang === 'en' ? 'Conversation rate' : '转化率' %></p>
      <p class="cn-test-board-rate" id="cn-board-rate"><%= (typeof board !== 'undefined' && board ? board.conversationRate : 0) + '%' %></p>
      <div class="cn-test-board-metrics">
        <div class="cn-test-board-metric">
          <div class="n" id="cn-board-interactions"><%= typeof board !== 'undefined' && board ? board.interactions : 0 %></div>
          <div class="l"><%= lang === 'en' ? 'Endpoint interactions' : '端点互动次数' %></div>
        </div>
        <div class="cn-test-board-metric">
          <div class="n" id="cn-board-customers"><%= typeof board !== 'undefined' && board ? board.customers : 0 %></div>
          <div class="l"><%= lang === 'en' ? 'Customers from endpoint' : '由此而来的客户' %></div>
        </div>
        <div class="cn-test-board-metric">
          <div class="n" id="cn-board-revenue"><%= typeof board !== 'undefined' && board ? ('$' + Number(board.revenue || 0).toLocaleString('en-US')) : '$0' %></div>
          <div class="l"><%= lang === 'en' ? 'Revenue through endpoint' : '端点带来的收入' %></div>
        </div>
      </div>
    </div>
    <aside class="cn-test-board-side">
      <div class="cn-test-board-drop" id="cn-board-drop" tabindex="0">
        <input type="file" id="cn-board-files" multiple accept=".pdf,.xlsx,.xls,.zip,.csv,.txt,.doc,.docx,application/pdf,application/zip,image/*,text/*">
        <p class="cn-test-board-drop-title"><%= lang === 'en' ? 'Drop files here' : '把文件拖到这里' %></p>
        <p class="cn-test-board-drop-sub"><%= lang === 'en' ? 'or click to upload' : '或点击上传' %></p>
      </div>
      <p class="cn-test-board-hint"><%= lang === 'en' ? 'Upload more context to increase conversation rate' : '上传更多上下文以提高转化率' %></p>
    </aside>
  </section>

  <div class="cn-test-dock" id="cn-test-dock" hidden>
    <div class="cn-test-pending" id="cn-test-pending"></div>
    <form class="cn-test-composer" id="cn-test-form">
      <label class="cn-test-attach" title="<%= lang === 'en' ? 'Attach' : '上传' %>">
        <input type="file" id="cn-test-files" multiple accept=".pdf,.xlsx,.xls,.zip,.csv,.txt,application/pdf,application/zip,image/*">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M21.4 11.6 12.1 20.9a5.2 5.2 0 0 1-7.4-7.4l9.9-9.9a3.5 3.5 0 0 1 4.9 4.9l-9.2 9.2a1.7 1.7 0 1 1-2.4-2.4l8.1-8.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </label>
      <textarea class="cn-test-input" id="cn-test-input" rows="1" placeholder="<%= lang === 'en' ? 'Drop files on the canvas, or type…' : '把文件丢到画面上，或直接输入…' %>"></textarea>
      <button class="cn-test-send" id="cn-test-send" type="submit" aria-label="<%= lang === 'en' ? 'Send' : '发送' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </form>
  </div>

  <div class="cn-test-auth" id="cn-test-auth" aria-hidden="true">
    <div class="cn-test-auth-card">
      <h2><%= lang === 'en' ? 'Log in' : '登录' %></h2>
      <p><%= lang === 'en'
        ? 'Work email → we send a 6-digit code. Same idea as magic link, typed instead of clicked.'
        : '工作邮箱 → 发 6 位验证码。和魔法链接一样，只是改成输入码。' %></p>
      <div class="cn-test-auth-msg" id="cn-test-auth-msg"></div>
      <label for="cn-test-auth-email"><%= lang === 'en' ? 'Email' : '邮箱' %></label>
      <input type="email" id="cn-test-auth-email" autocomplete="email" placeholder="you@factory.com">
      <div id="cn-test-auth-code-wrap" hidden>
        <label for="cn-test-auth-code"><%= lang === 'en' ? 'Code' : '验证码' %></label>
        <input type="text" id="cn-test-auth-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456">
      </div>
      <div class="cn-test-auth-actions">
        <button type="button" class="cn-btn-ghost" id="cn-test-auth-cancel"><%= lang === 'en' ? 'Cancel' : '取消' %></button>
        <button type="button" class="cn-btn" id="cn-test-auth-go"><%= lang === 'en' ? 'Send code' : '发送验证码' %></button>
      </div>
    </div>
  </div>

  <!-- Board is the only main surface on /test. -->
  <script>document.body.classList.add('cn-test-has-board');</script>

  <script src="/airsup/china/test/test-network.js?v=2"></script>
  <script>
  (function () {
    var lang = document.body.getAttribute('data-lang') || 'zh';
    var en = lang === 'en';
    var webKey = 'airsup_china_test_web_v6';
    var form = document.getElementById('cn-test-form');
    var input = document.getElementById('cn-test-input');
    var fileInput = document.getElementById('cn-test-files');
    var pendingEl = document.getElementById('cn-test-pending');
    var sendBtn = document.getElementById('cn-test-send');
    var dockEl = document.getElementById('cn-test-dock');
    var actionsEl = document.getElementById('cn-test-actions');
    var networkEl = document.getElementById('cn-test-network');
    var spark = document.getElementById('cn-test-spark');
    var reachEl = document.getElementById('cn-test-reach');
    var emptyEl = document.getElementById('cn-test-empty');
    var toastEl = document.getElementById('cn-test-toast');
    var authEl = document.getElementById('cn-test-auth');
    var authMsg = document.getElementById('cn-test-auth-msg');
    var authEmail = document.getElementById('cn-test-auth-email');
    var authCode = document.getElementById('cn-test-auth-code');
    var authCodeWrap = document.getElementById('cn-test-auth-code-wrap');
    var authGo = document.getElementById('cn-test-auth-go');
    var detailsEl = document.getElementById('cn-test-details');
    var detailsKind = document.getElementById('cn-test-details-kind');
    var detailsTitle = document.getElementById('cn-test-details-title');
    var detailsBody = document.getElementById('cn-test-details-body');
    var onboardEl = document.getElementById('cn-test-onboard');
    var obMsg = document.getElementById('cn-ob-msg');
    var obPreview = document.getElementById('cn-ob-preview');
    var obGaps = document.getElementById('cn-ob-gaps');
    var obKicker = document.getElementById('cn-ob-kicker');
    var obTitle = document.getElementById('cn-ob-title');
    var obLead = document.getElementById('cn-ob-lead');
    var obVerifyNow = document.getElementById('cn-ob-verify-now');
    var initialWeb = <%- JSON.stringify(initialWeb) %>;
    var initialOnboard = <%- JSON.stringify(onboard || { step: 'live' }) %>;
    var initialBoard = <%- JSON.stringify(typeof board !== 'undefined' ? board : { conversationRate: 0, interactions: 0, customers: 0, revenue: 0 }) %>;
    var boardFirst = document.body.getAttribute('data-board-first') === '1' || true;
    var initialLoggedIn = document.body.getAttribute('data-logged-in') === '1';
    var pendingFiles = [];
    var busy = false;
    var obBusy = false;
    var boardBusy = false;
    var toastTimer = null;
    var authStep = 'email';
    var mounted = false;
    var draftWebsite = '';
    var lastPreview = null;
    var verifyPath = '';
    var state = Object.assign({ step: 'live' }, initialOnboard || {}, boardFirst ? { step: 'live' } : {});
    var boardEl = document.getElementById('cn-test-board');
    var boardDrop = document.getElementById('cn-board-drop');
    var boardFiles = document.getElementById('cn-board-files');
    var reachFloat = document.querySelector('.cn-test-reach-float');

    var copy = en ? {
      kicker: 'Factory onboarding',
      siteTitle: 'Start with your site',
      siteLead: 'We read the public pages and draft your ChatGPT endpoint.',
      emailTitle: 'Confirm it is you',
      emailLead: 'Work email on your domain. We send a one-click verify link.',
      verifyTitle: 'Check your mail',
      verifyLead: 'Open the link we sent. Demo can verify instantly below.',
      fieldsTitle: 'Buyer-facing details',
      fieldsLead: 'WeChat, sample lead, and how flexible you are on RFQs.',
      liveTitle: 'You are live',
      liveLead: 'Dump quotes and scraps into the web. Reach stays visible above.',
      liveBody: 'Published. Grow the endpoint web with real factory material.',
      checkMail: 'We sent a verify link. After you click it, fill buyer fields and publish.',
      previewFail: 'Could not read that site.',
      startFail: 'Could not start signup.',
      fieldsFail: 'Could not save fields.',
      publishFail: 'Could not publish yet.',
      needQuality: 'Add WeChat and a sample lead you will stand behind before publishing.',
      gapsTitle: 'Still thin for ChatGPT answers:',
      continue: 'Continue',
      resendOk: 'Link resent.',
      rateWait: 'Please wait about 2 minutes before requesting another email.',
    } : {
      kicker: '工厂上线',
      siteTitle: '从网站开始',
      siteLead: '读取公开页面，起草你的 ChatGPT 端点。',
      emailTitle: '确认是你',
      emailLead: '公司域名工作邮箱。我们发一键验证链接。',
      verifyTitle: '查收邮件',
      verifyLead: '打开邮件里的链接。演示可在下方立刻验证。',
      fieldsTitle: '给采购看的信息',
      fieldsLead: '微信、样品交期、询盘灵活度。',
      liveTitle: '已上线',
      liveLead: '把报价和碎片丢进网。上方始终显示触达。',
      liveBody: '已发布。用真实材料把端点网养亮。',
      checkMail: '验证链接已发送。点开后填写买家字段再发布。',
      previewFail: '读不了这个网站。',
      startFail: '无法开始注册。',
      fieldsFail: '无法保存字段。',
      publishFail: '还不能发布。',
      needQuality: '上线前请填写微信号和你能承诺的样品交期。',
      gapsTitle: 'ChatGPT 回答还偏薄：',
      continue: '继续',
      resendOk: '链接已重发。',
      rateWait: '请约 2 分钟后再请求邮件。',
    };

    function loadJson(key, fallback) {
      try {
        var raw = localStorage.getItem(key);
        if (!raw) return fallback;
        return JSON.parse(raw);
      } catch (e) { return fallback; }
    }
    function saveJson(key, value) {
      try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) {}
    }
    function esc(text) {
      return String(text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function formatSize(n) {
      n = Number(n) || 0;
      if (n < 1024) return n + ' B';
      if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
      return (n / (1024 * 1024)).toFixed(1) + ' MB';
    }
    function fileExt(name) {
      var m = String(name || '').match(/\.([a-z0-9]+)$/i);
      return (m ? m[1] : 'FILE').toUpperCase().slice(0, 4);
    }
    function toast(text) {
      if (!text) return;
      toastEl.textContent = text;
      toastEl.classList.add('is-on');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { toastEl.classList.remove('is-on'); }, 3200);
    }
    function qs(name) {
      try {
        return new URLSearchParams(window.location.search).get(name) || '';
      } catch (e) { return ''; }
    }
    // Prefer SSR flags — browser tooling sometimes strips ?demo before client JS runs.
    // Board-first /test never runs the onboarding demo wizard.
    var wantDemo = !boardFirst && (document.body.getAttribute('data-demo') === '1' || qs('demo') === '1');
    var wantAuto = !boardFirst && (document.body.getAttribute('data-auto') === '1' || qs('auto') === '1');

    function hideDetails() {
      detailsEl.classList.add('hidden');
    }
    function showDetails(node) {
      if (!node) return hideDetails();
      detailsKind.textContent = node.kind || 'note';
      detailsTitle.textContent = node.label || '';
      detailsBody.textContent = node.detail || node.label || '';
      detailsEl.classList.remove('hidden');
    }

    function renderSpark(history) {
      var vals = (history || [0]).map(function (n) { return Number(n) || 0; });
      if (vals.length < 2) vals = [vals[0] || 0, vals[0] || 0];
      var min = Math.min.apply(null, vals.concat([0]));
      var max = Math.max.apply(null, vals.concat([12]));
      if (max - min < 6) max = min + 6;
      var w = 72;
      var h = 14;
      var pts = vals.map(function (v, i) {
        var x = (i / (vals.length - 1)) * (w - 2) + 1;
        var y = h - 2 - ((v - min) / (max - min)) * (h - 4);
        return x.toFixed(1) + ',' + y.toFixed(1);
      }).join(' ');
      spark.innerHTML = '<polyline fill="none" stroke="#C16A28" stroke-width="1.3" stroke-linecap="round" points="' + pts + '"></polyline>';
    }

    function renderReach(web) {
      reachEl.innerHTML = String(web.reach || 0) + '<span>/100</span>';
      renderSpark(web.reachHistory || [web.reach || 0]);
    }

    function paintNetwork(web, forceRemount) {
      var count = Object.keys(web.nodes || {}).length;
      emptyEl.classList.toggle('is-gone', count > 0);
      renderReach(web);
      if (!count) {
        AirsupChinaTestNetwork.destroy();
        mounted = false;
        return;
      }
      if (!mounted || forceRemount) {
        AirsupChinaTestNetwork.mount(networkEl, web, {
          onSelect: showDetails,
          onDeselect: hideDetails,
        });
        mounted = true;
      } else if (!AirsupChinaTestNetwork.syncWeb(web)) {
        AirsupChinaTestNetwork.mount(networkEl, web, {
          onSelect: showDetails,
          onDeselect: hideDetails,
        });
        mounted = true;
      }
    }

    function applyWeb(next, forceRemount) {
      if (!next) return;
      web = next;
      saveJson(webKey, web);
      paintNetwork(web, Boolean(forceRemount));
    }

    function setDockVisible(on) {
      dockEl.hidden = !on;
    }

    function setObBusy(on) {
      obBusy = Boolean(on);
      ['cn-ob-continue-site', 'cn-ob-continue-email', 'cn-ob-publish', 'cn-ob-resend'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.disabled = obBusy;
      });
    }

    function formatMoney(n) {
      var v = Math.round(Number(n) || 0);
      if (en) return '$' + v.toLocaleString('en-US');
      return '$' + v.toLocaleString('en-US');
    }

    function emptyBoard() {
      return { conversationRate: 0, interactions: 0, customers: 0, revenue: 0, contextScore: 0 };
    }

    function renderBoard(board) {
      if (!boardEl) return;
      // Board-first: never tear down the shell — show zeros when logged out.
      var next = board || emptyBoard();
      document.getElementById('cn-board-rate').textContent = String(next.conversationRate || 0) + '%';
      document.getElementById('cn-board-interactions').textContent = String(next.interactions || 0);
      document.getElementById('cn-board-customers').textContent = String(next.customers || 0);
      document.getElementById('cn-board-revenue').textContent = formatMoney(next.revenue);
      boardEl.hidden = false;
      boardEl.classList.add('is-ready');
      document.body.classList.add('cn-test-has-board');
      if (reachFloat) reachFloat.hidden = true;
      if (emptyEl) emptyEl.classList.add('is-gone');
      if (onboardEl) onboardEl.hidden = true;
      setDockVisible(false);
    }

    async function uploadBoardContext(fileList) {
      if (boardBusy) return;
      var files = Array.prototype.slice.call(fileList || []);
      if (!files.length) return;
      boardBusy = true;
      boardDrop.classList.add('is-busy');
      try {
        var body = new FormData();
        body.append('web', JSON.stringify(web));
        files.forEach(function (f) { body.append('files', f); });
        var res = await fetch('/airsup/china/test/api/board/context', {
          method: 'POST',
          body: body,
          credentials: 'same-origin',
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.ok) {
          toast(en ? 'Upload failed.' : '上传失败。');
          return;
        }
        if (data.web) applyWeb(data.web, true);
        if (data.board) renderBoard(data.board);
        toast(en
          ? ('Conversation rate ' + (data.board && data.board.conversationRate) + '%')
          : ('转化率 ' + (data.board && data.board.conversationRate) + '%'));
      } catch (e) {
        toast(en ? 'Upload failed.' : '上传失败。');
      } finally {
        boardBusy = false;
        boardDrop.classList.remove('is-busy');
      }
    }

    function showObStep(step) {
      document.querySelectorAll('.cn-ob-step').forEach(function (el) {
        el.hidden = el.getAttribute('data-step') !== step;
      });
      document.body.setAttribute('data-onboard-step', step || 'site');
      var map = {
        site: [copy.siteTitle, copy.siteLead],
        email: [copy.emailTitle, copy.emailLead],
        verify: [copy.verifyTitle, copy.verifyLead],
        fields: [copy.fieldsTitle, copy.fieldsLead],
        live: [copy.liveTitle, copy.liveLead]
      };
      var pair = map[step] || map.site;
      obKicker.textContent = copy.kicker;
      obTitle.textContent = pair[0];
      obLead.textContent = pair[1];
      document.getElementById('cn-ob-check-copy').textContent = copy.checkMail;
      document.getElementById('cn-ob-live-copy').textContent = copy.liveBody;
      // /test is board-only — never show onboarding panel or dump dock.
      setDockVisible(false);
      if (onboardEl) {
        onboardEl.hidden = true;
        onboardEl.classList.add('is-compact');
      }
      if (reachFloat) reachFloat.hidden = true;
      if (emptyEl) emptyEl.classList.add('is-gone');
      document.body.classList.add('cn-test-has-board');
    }

    function renderGaps(gaps) {
      if (!obGaps) return;
      var list = Array.isArray(gaps) ? gaps : [];
      if (!list.length || (state && state.step === 'live')) {
        obGaps.hidden = true;
        obGaps.innerHTML = '';
        return;
      }
      var whyKey = en ? 'why_en' : 'why_zh';
      obGaps.innerHTML = '<li class="cn-ob-gaps-title">' + esc(copy.gapsTitle) + '</li>'
        + list.slice(0, 5).map(function (g) {
          return '<li>' + esc(g[whyKey] || g.why || g.field || '') + '</li>';
        }).join('');
      obGaps.hidden = false;
    }

    function renderPreviewCard(preview, summary) {
      if (!preview && !summary) {
        obPreview.hidden = true;
        obPreview.innerHTML = '';
        return;
      }
      var name = (preview && (preview.companyName || preview.companyNameEn)) || '';
      var bits = [
        name,
        preview && preview.domain,
        preview && preview.city,
        Array.isArray(preview && preview.capabilities) ? preview.capabilities.slice(0, 3).join(', ') : '',
        summary || (preview && preview.summary) || ''
      ].filter(Boolean);
      obPreview.innerHTML = bits.map(function (b) { return '<span>' + esc(b) + '</span>'; }).join('');
      obPreview.hidden = bits.length === 0;
    }

    function fillFieldInputs(next) {
      if (!next) return;
      if (next.email) document.getElementById('cn-ob-email').value = next.email;
      if (next.domain && !document.getElementById('cn-ob-website').value) {
        document.getElementById('cn-ob-website').value = 'https://' + next.domain;
        draftWebsite = 'https://' + next.domain;
      }
      if (next.wechat) document.getElementById('cn-ob-wechat').value = next.wechat;
      if (next.sampleLead) document.getElementById('cn-ob-sample').value = next.sampleLead;
      if (next.flexibility) document.getElementById('cn-ob-flex').value = next.flexibility;
      if (next.contactName) {
        document.getElementById('cn-ob-contact').value = next.contactName;
        document.getElementById('cn-ob-contact-fields').value = next.contactName;
      }
    }

    function applyState(next, extra) {
      state = next || state || { step: 'live' };
      var step = boardFirst ? 'live' : (state.step || 'site');
      // After preview, show email form before company exists.
      if (!boardFirst && extra && extra.forceEmail) step = 'email';
      if (!boardFirst && extra && extra.verifyPath) {
        verifyPath = extra.verifyPath;
        step = 'verify';
      }
      if (boardFirst) {
        state.step = 'live';
        verifyPath = '';
      }
      showObStep(step);
      if (state.previewSummary) renderPreviewCard(lastPreview, state.previewSummary);
      else if (lastPreview) renderPreviewCard(lastPreview, '');
      renderGaps(state.gaps);
      fillFieldInputs(state);
      if (verifyPath) {
        obVerifyNow.hidden = false;
        obVerifyNow.setAttribute('href', verifyPath);
      } else {
        obVerifyNow.hidden = true;
      }
      // Only mark logged-in when the caller says so, or on SSR resume for verified/live.
      if (extra && typeof extra.loggedIn === 'boolean') {
        if (extra.loggedIn && state.title) setLoggedIn(true, state.title);
        else if (!extra.loggedIn) setLoggedIn(false, '');
      } else if (initialLoggedIn && state.title) {
        setLoggedIn(true, state.title);
      }
      if (step === 'live' || boardFirst) {
        if (extra && extra.board) renderBoard(extra.board);
        else if (initialBoard) renderBoard(initialBoard);
        else {
          apiJson('/airsup/china/test/api/board', { method: 'GET', headers: {} }).then(function (out) {
            if (out.data && out.data.board) renderBoard(out.data.board);
          });
        }
      }
    }

    function setObMsg(text) {
      obMsg.textContent = text || '';
    }

    async function apiJson(url, opts) {
      var res = await fetch(url, Object.assign({
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
      }, opts || {}));
      var data = await res.json().catch(function () { return {}; });
      return { res: res, data: data };
    }

    function renderPending() {
      pendingEl.innerHTML = pendingFiles.map(function (f, i) {
        return '<div class="cn-test-file-card" data-i="' + i + '">'
          + '<span class="cn-test-file-ico">' + esc(fileExt(f.name)) + '</span>'
          + '<span class="cn-test-file-name">' + esc(f.name) + '</span>'
          + '<span class="cn-test-file-size">' + esc(formatSize(f.size)) + '</span>'
          + '</div>';
      }).join('');
      pendingEl.querySelectorAll('[data-i]').forEach(function (chip) {
        chip.addEventListener('click', function () {
          pendingFiles.splice(Number(chip.getAttribute('data-i')), 1);
          renderPending();
        });
      });
    }

    function autosize() {
      input.style.height = 'auto';
      input.style.height = Math.min(100, input.scrollHeight) + 'px';
    }

    function openAuth() {
      authStep = 'email';
      authMsg.textContent = '';
      authCodeWrap.hidden = true;
      authCode.value = '';
      authGo.textContent = en ? 'Send code' : '发送验证码';
      authEl.classList.add('is-open');
      authEl.setAttribute('aria-hidden', 'false');
      authEmail.focus();
    }
    function closeAuth() {
      authEl.classList.remove('is-open');
      authEl.setAttribute('aria-hidden', 'true');
    }

    function bindAuthButtons() {
      var loginBtn = document.getElementById('cn-test-login');
      var logoutBtn = document.getElementById('cn-test-logout');
      if (loginBtn) loginBtn.addEventListener('click', openAuth);
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async function () {
          try {
            await fetch('/airsup/china/test/api/logout', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: '{}',
            });
          } catch (e) {}
          setLoggedIn(false, '');
          initialBoard = emptyBoard();
          renderBoard(initialBoard);
          applyState({ step: 'live', status: null, title: '', gaps: [] }, { loggedIn: false, board: initialBoard });
        });
      }
    }

    function setLoggedIn(on, name) {
      document.body.setAttribute('data-logged-in', on ? '1' : '0');
      var langLink = actionsEl.querySelector('.cn-lang');
      var langHtml = langLink ? langLink.outerHTML : '';
      if (on) {
        actionsEl.innerHTML =
          '<span class="cn-test-who" id="cn-test-who" title="' + esc(name || '') + '">' + esc(name || '') + '</span>'
          + '<button type="button" class="cn-btn-ghost" id="cn-test-logout">' + (en ? 'Log out' : '退出') + '</button>'
          + langHtml;
      } else {
        actionsEl.innerHTML =
          '<button type="button" class="cn-btn" id="cn-test-login">' + (en ? 'Log in' : '登录') + '</button>'
          + langHtml;
      }
      bindAuthButtons();
    }

    async function sendTurn(text, filesSnap) {
      if (busy) return;
      if (!text && !(filesSnap && filesSnap.length)) return;
      busy = true;
      sendBtn.disabled = true;
      try {
        var body = new FormData();
        body.append('message', text || '');
        body.append('history', '[]');
        body.append('web', JSON.stringify(web));
        (filesSnap || []).forEach(function (f) { body.append('files', f); });

        var res = await fetch('/airsup/china/test/api/chat', {
          method: 'POST',
          body: body,
          credentials: 'same-origin',
        });
        var data = await res.json().catch(function () { return {}; });
        if (data.web) applyWeb(data.web);
        if (data.reply) toast(data.reply);
      } catch (err) {
        toast(en ? 'Network error.' : '网络错误。');
      } finally {
        busy = false;
        sendBtn.disabled = false;
        input.focus();
      }
    }

    var web = loadJson(webKey, null);
    var serverSeeded = initialWeb && initialWeb.nodes && Object.keys(initialWeb.nodes).length > 0;
    var localEmpty = !web || !web.nodes || Array.isArray(web.nodes) || web.nodes.core
      || !Object.keys(web.nodes || {}).length;
    // Prefer server seed when logged in / company present so resume is not blanked by stale localStorage.
    if (localEmpty || (initialLoggedIn && serverSeeded)) {
      web = initialWeb || { nodes: {}, edges: [], reach: 0, reachHistory: [0] };
      saveJson(webKey, web);
    }
    paintNetwork(web, true);
    bindAuthButtons();
    applyState(state, { loggedIn: initialLoggedIn, board: initialBoard });

    if (boardDrop && boardFiles) {
      boardDrop.addEventListener('click', function () { boardFiles.click(); });
      boardFiles.addEventListener('change', function () {
        uploadBoardContext(boardFiles.files);
        boardFiles.value = '';
      });
      ;['dragenter', 'dragover'].forEach(function (ev) {
        boardDrop.addEventListener(ev, function (e) {
          e.preventDefault();
          boardDrop.classList.add('is-drag');
        });
      });
      ;['dragleave', 'drop'].forEach(function (ev) {
        boardDrop.addEventListener(ev, function (e) {
          e.preventDefault();
          boardDrop.classList.remove('is-drag');
        });
      });
      boardDrop.addEventListener('drop', function (e) {
        var list = e.dataTransfer && e.dataTransfer.files ? e.dataTransfer.files : [];
        uploadBoardContext(list);
      });
    }

    var errKey = qs('err');
    if (errKey) {
      setObMsg(en
        ? (errKey.indexOf('token') >= 0 ? 'Confirm link invalid or expired. Request a new one.' : 'Something went wrong. Try again.')
        : (errKey.indexOf('token') >= 0 ? '确认链接无效或已过期。请重新获取。' : '出错了，请重试。'));
    }

    if (qs('ok') === 'verified') {
      toast(en ? 'Email verified.' : '邮箱已验证。');
      initialLoggedIn = true;
      apiJson('/airsup/china/test/api/onboard/state', { method: 'GET', headers: {} }).then(function (out) {
        if (out.data && out.data.state) applyState(out.data.state, { loggedIn: Boolean(out.data.loggedIn) });
        if (out.data && out.data.web) applyWeb(out.data.web, true);
        if (out.data && out.data.company && out.data.company.name) {
          setLoggedIn(true, out.data.company.name);
        }
      });
    }

    document.getElementById('cn-ob-continue-site').addEventListener('click', async function () {
      if (obBusy) return;
      setObMsg('');
      var website = String(document.getElementById('cn-ob-website').value || '').trim();
      if (!website) {
        setObMsg(copy.previewFail);
        return;
      }
      setObBusy(true);
      try {
        var out = await apiJson('/airsup/china/test/api/onboard/preview', {
          method: 'POST',
          body: JSON.stringify({ website: website }),
        });
        if (!out.res.ok || !out.data.ok) {
          setObMsg((out.data && out.data.error) || copy.previewFail);
          return;
        }
        lastPreview = out.data.preview;
        draftWebsite = (lastPreview && lastPreview.website) || website;
        document.getElementById('cn-ob-website').value = draftWebsite;
        if (lastPreview && lastPreview.cityId) {
          document.getElementById('cn-ob-city').value = lastPreview.cityId;
        }
        if (out.data.web) applyWeb(out.data.web, true);
        renderPreviewCard(lastPreview, '');
        applyState(state, { forceEmail: true, loggedIn: false });
      } catch (e) {
        setObMsg(copy.previewFail);
      } finally {
        setObBusy(false);
      }
    });

    async function runStartSignup() {
      var out = await apiJson('/airsup/china/test/api/onboard/start', {
        method: 'POST',
        body: JSON.stringify({
          website: draftWebsite || String(document.getElementById('cn-ob-website').value || '').trim(),
          email: String(document.getElementById('cn-ob-email').value || '').trim(),
          contact: String(document.getElementById('cn-ob-contact').value || '').trim(),
          city: String(document.getElementById('cn-ob-city').value || 'shenzhen'),
        }),
      });
      if (!out.res.ok || !out.data.ok) {
        var key = out.data && out.data.errorKey;
        setObMsg((out.data && out.data.error) || (key === 'err_rate' ? copy.rateWait : copy.startFail));
        return null;
      }
      if (out.data.web) applyWeb(out.data.web, true);
      applyState(out.data.state, { verifyPath: out.data.verifyPath || '', loggedIn: false });
      if (out.data.verifyPath) {
        obVerifyNow.hidden = false;
        obVerifyNow.setAttribute('href', out.data.verifyPath);
      }
      return out.data;
    }

    document.getElementById('cn-ob-continue-email').addEventListener('click', async function () {
      if (obBusy) return;
      setObMsg('');
      setObBusy(true);
      try {
        await runStartSignup();
      } catch (e) {
        setObMsg(copy.startFail);
      } finally {
        setObBusy(false);
      }
    });

    document.getElementById('cn-ob-resend').addEventListener('click', async function () {
      if (obBusy) return;
      setObMsg('');
      setObBusy(true);
      try {
        var data = await runStartSignup();
        if (data) setObMsg(copy.resendOk);
      } catch (e) {
        setObMsg(copy.startFail);
      } finally {
        setObBusy(false);
      }
    });

    document.getElementById('cn-ob-publish').addEventListener('click', async function () {
      if (obBusy) return;
      setObMsg('');
      var wechatVal = String(document.getElementById('cn-ob-wechat').value || '').trim();
      var sampleVal = String(document.getElementById('cn-ob-sample').value || '').trim();
      if (!wechatVal || !sampleVal) {
        setObMsg(copy.needQuality);
        return;
      }
      setObBusy(true);
      try {
        var fieldsOut = await apiJson('/airsup/china/test/api/onboard/fields', {
          method: 'POST',
          body: JSON.stringify({
            wechat: wechatVal,
            sample_lead: sampleVal,
            flexibility: String(document.getElementById('cn-ob-flex').value || 'normal'),
            contact_name: String(document.getElementById('cn-ob-contact-fields').value || '').trim(),
          }),
        });
        if (!fieldsOut.res.ok || !fieldsOut.data.ok) {
          setObMsg((fieldsOut.data && fieldsOut.data.error) || copy.fieldsFail);
          return;
        }
        if (fieldsOut.data.web) applyWeb(fieldsOut.data.web, true);
        applyState(fieldsOut.data.state, { loggedIn: true });
        if (!fieldsOut.data.state || !fieldsOut.data.state.qualityReady) {
          var st = fieldsOut.data.state;
          // canPublish false → enrichment gaps; else missing WeChat/sample quality gate.
          setObMsg(st && st.canPublish ? copy.needQuality : copy.publishFail);
          renderGaps(st && st.gaps);
          return;
        }
        var pubOut = await apiJson('/airsup/china/test/api/onboard/publish', {
          method: 'POST',
          body: '{}',
        });
        if (!pubOut.res.ok || !pubOut.data.ok) {
          setObMsg((pubOut.data && pubOut.data.error) || copy.publishFail);
          applyState(fieldsOut.data.state, { loggedIn: true });
          return;
        }
        if (pubOut.data.web) applyWeb(pubOut.data.web, true);
        applyState(pubOut.data.state, { loggedIn: true, board: pubOut.data.board || null });
        if (pubOut.data.company && pubOut.data.company.name) {
          setLoggedIn(true, pubOut.data.company.name);
        }
        toast(en ? 'Published.' : '已上线。');
      } catch (e) {
        setObMsg(copy.publishFail);
      } finally {
        setObBusy(false);
      }
    });

    if (wantDemo) {
      (async function () {
        setObMsg(en ? 'Starting demo…' : '正在启动演示…');
        setObBusy(true);
        try {
          var out = await apiJson('/airsup/china/test/api/onboard/demo', {
            method: 'POST',
            body: '{}',
          });
          if (!out.res.ok || !out.data.ok) {
            setObMsg((out.data && out.data.error) || copy.startFail);
            return;
          }
          draftWebsite = 'https://demo.com';
          document.getElementById('cn-ob-website').value = draftWebsite;
          document.getElementById('cn-ob-email').value = 'tade@demo.com';
          document.getElementById('cn-ob-contact').value = 'Tade';
          if (out.data.web) applyWeb(out.data.web, true);
          if (out.data.preview && out.data.preview.ok) {
            lastPreview = out.data.preview;
          }
          applyState(out.data.state, { verifyPath: out.data.verifyPath || '', loggedIn: false });
          if (lastPreview) renderPreviewCard(lastPreview, (out.data.state && out.data.state.previewSummary) || '');
          setObMsg('');
          if (wantAuto && out.data.verifyPath) {
            var next = out.data.verifyPath;
            next += (next.indexOf('?') >= 0 ? '&' : '?') + 'auto=1';
            window.location.href = next;
            return;
          }
          // Non-auto: drop ?demo so refresh does not reset mid-session.
          try {
            history.replaceState({}, '', '/airsup/china/test' + (en ? '?lang=en' : ''));
          } catch (e2) {}
        } catch (e) {
          setObMsg(copy.startFail);
        } finally {
          setObBusy(false);
        }
      })();
    }

    // After verify with ?auto=1, finish WeChat/sample → publish for a smooth full-funnel demo.
    (async function runAutoFields() {
      if (!wantAuto) return;
      if (!state || state.step !== 'fields') return;
      await new Promise(function (r) { setTimeout(r, 700); });
      document.getElementById('cn-ob-wechat').value = state.wechat || 'airsup_demo_tade';
      document.getElementById('cn-ob-sample').value = state.sampleLead || (en ? 'samples in 5 days' : '样品 5 天');
      document.getElementById('cn-ob-flex').value = state.flexibility || 'normal';
      if (state.contactName) document.getElementById('cn-ob-contact-fields').value = state.contactName;
      document.getElementById('cn-ob-publish').click();
    })();

    fileInput.addEventListener('change', function () {
      Array.prototype.slice.call(fileInput.files || []).forEach(function (f) { pendingFiles.push(f); });
      fileInput.value = '';
      renderPending();
    });

    ;['dragenter', 'dragover'].forEach(function (ev) {
      networkEl.addEventListener(ev, function (e) {
        e.preventDefault();
        networkEl.classList.add('is-drag');
      });
    });
    ;['dragleave', 'drop'].forEach(function (ev) {
      networkEl.addEventListener(ev, function (e) {
        e.preventDefault();
        networkEl.classList.remove('is-drag');
      });
    });
    networkEl.addEventListener('drop', function (e) {
      if (dockEl.hidden) return;
      var list = e.dataTransfer && e.dataTransfer.files ? Array.prototype.slice.call(e.dataTransfer.files) : [];
      if (!list.length) return;
      sendTurn('', list);
    });

    input.addEventListener('input', autosize);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var text = String(input.value || '').trim();
      var filesSnap = pendingFiles.slice();
      pendingFiles = [];
      renderPending();
      input.value = '';
      autosize();
      sendTurn(text, filesSnap);
    });

    document.getElementById('cn-test-details-close').addEventListener('click', hideDetails);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') hideDetails();
    });

    document.getElementById('cn-test-auth-cancel').addEventListener('click', closeAuth);
    authEl.addEventListener('click', function (e) {
      if (e.target === authEl) closeAuth();
    });
    authGo.addEventListener('click', async function () {
      authMsg.textContent = '';
      authGo.disabled = true;
      try {
        if (authStep === 'email') {
          var email = String(authEmail.value || '').trim();
          var res = await fetch('/airsup/china/test/api/login/request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ email: email }),
          });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok) throw new Error(data.error || 'request');
          authStep = 'code';
          authCodeWrap.hidden = false;
          authGo.textContent = en ? 'Verify' : '验证';
          authMsg.textContent = data.devCode
            ? ((en ? 'Concept code: ' : '概念验证码：') + data.devCode)
            : (en ? 'Code sent. Check your inbox.' : '验证码已发送，请查收邮箱。');
          authCode.focus();
        } else {
          var res2 = await fetch('/airsup/china/test/api/login/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              email: String(authEmail.value || '').trim(),
              code: String(authCode.value || '').trim(),
            }),
          });
          var data2 = await res2.json().catch(function () { return {}; });
          if (!res2.ok) throw new Error(data2.error || 'verify');
          closeAuth();
          setLoggedIn(true, (data2.company && data2.company.name) || '');
          if (data2.web) applyWeb(data2.web, true);
          toast(en ? 'Signed in.' : '已登录。');
          var boardOut = await apiJson('/airsup/china/test/api/board', { method: 'GET', headers: {} });
          if (boardOut.data && boardOut.data.board) {
            initialBoard = boardOut.data.board;
            renderBoard(initialBoard);
          }
          if (boardOut.data && boardOut.data.state) {
            applyState(boardOut.data.state, { loggedIn: true, board: initialBoard });
          } else {
            var st = await apiJson('/airsup/china/test/api/onboard/state', { method: 'GET', headers: {} });
            if (st.data && st.data.state) applyState(st.data.state, { loggedIn: true, board: initialBoard });
          }
        }
      } catch (err) {
        authMsg.textContent = en ? 'Could not continue. Check email / code.' : '无法继续，请检查邮箱或验证码。';
      } finally {
        authGo.disabled = false;
      }
    });
  })();
  </script>
</body>
</html>
