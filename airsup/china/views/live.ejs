<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
</head>
<body class="cn-body">
  <%- include('partials/header') %>
  <main class="cn-wrap cn-inner">
    <% if (typeof isDemo !== 'undefined' && isDemo) { %>
      <p class="cn-stamp cn-demo-stamp"><%= t('demo_stamp') %></p>
      <p class="cn-note cn-demo-banner"><%= t('demo_banner') %></p>
      <p class="cn-note">
        <a class="cn-text-link" href="/airsup/china/demo/onboarding"><%= t('demo_restart_onboarding') %></a>
        ·
        <a class="cn-text-link" href="/airsup/china/demo"><%= t('demo_open_live') %></a>
      </p>
    <% } %>
    <p class="cn-stamp"><%= t('live_stamp') %></p>
    <h1><%= t('live_title') %></h1>
    <p class="cn-lead"><%= t('live_lead') %></p>
    <p class="cn-proof"><%= proofLine %></p>

    <section class="cn-found" aria-labelledby="live-boss-title">
      <h2 id="live-boss-title" class="cn-live-h2"><%= t('live_boss_title') %></h2>
      <p class="cn-lead"><%= t('live_boss_found') %></p>
      <table class="cn-spec">
        <tbody>
          <tr><th><%= lang === 'en' ? 'Company' : '公司' %></th><td><%= companyTitle %></td></tr>
          <tr><th><%= t('live_boss_domain') %></th><td><%= company.domain %></td></tr>
          <tr><th><%= t('live_boss_email') %></th><td><%= company.contact_email %></td></tr>
          <% if (liveAtLabel) { %>
            <tr><th><%= t('live_boss_since') %></th><td><%= liveAtLabel %></td></tr>
          <% } %>
          <tr><th><%= t('live_status_label') %></th><td><%= t('live_status_value') %></td></tr>
        </tbody>
      </table>
    </section>

    <section class="cn-live-test" aria-labelledby="live-summary-title">
      <h2 id="live-summary-title" class="cn-live-h2"><%= t('live_summary_title') %></h2>
      <p class="cn-muted"><%= t('live_summary_lead') %></p>
      <p class="cn-lead"><%= operatorSummary %></p>
    </section>

    <section class="cn-live-test" aria-labelledby="live-next-title">
      <h2 id="live-next-title" class="cn-live-h2"><%= t('live_next_title') %></h2>
      <ul class="cn-muted">
        <li><%= t('live_next_1') %></li>
        <li><%= t('live_next_2') %></li>
        <li><%= t('live_next_3') %></li>
      </ul>
    </section>

    <section class="cn-live-test" aria-labelledby="live-test-title">
      <h2 id="live-test-title" class="cn-live-h2"><%= t('live_test_title') %></h2>
      <p class="cn-muted"><%= t('live_test_lead') %></p>
      <p class="cn-note"><%= t('live_en_prompt_note') %></p>
      <pre class="cn-live-prompt" id="live-buyer-prompt"><%= buyerPrompt %></pre>
      <button type="button" class="cn-btn-ghost" id="live-copy-prompt"><%= t('live_test_copy') %></button>
    </section>

    <section class="cn-live-listing" aria-labelledby="live-listing-title">
      <h2 id="live-listing-title" class="cn-live-h2"><%= t('live_listing_title') %></h2>
      <p class="cn-muted"><%= t('live_listing_lead') %></p>
      <p class="cn-note"><%= t('live_en_listing_note') %></p>
      <pre class="cn-live-listing-text"><%= listingPreview %></pre>
    </section>

    <% if (typeof enrichmentGaps !== 'undefined' && enrichmentGaps && enrichmentGaps.length) { %>
      <details class="cn-more">
        <summary><%= t('live_gaps_summary') %></summary>
        <p class="cn-muted"><%= t('enrich_gaps_lead') %></p>
        <ul class="cn-muted">
          <% enrichmentGaps.slice(0, 6).forEach(function (gap) { %>
            <li><%= t('enrich_need_prefix') %> <%= gapWhy(gap) %></li>
          <% }) %>
        </ul>
        <p><a class="cn-text-link" href="/airsup/china/setup?edit=1"><%= t('live_edit') %></a></p>
      </details>
    <% } %>

    <%- include('partials/quotations', { quotationMeta: typeof quotationMeta !== 'undefined' ? quotationMeta : { documents: [], endpoint_use: false } }) %>

    <p><a class="cn-text-link" href="/airsup/china/setup?edit=1"><%= t('live_edit') %></a></p>
  </main>
  <%- include('partials/footer') %>
  <script>
    (function () {
      var btn = document.getElementById('live-copy-prompt');
      var pre = document.getElementById('live-buyer-prompt');
      if (!btn || !pre) return;
      btn.addEventListener('click', function () {
        var text = pre.textContent || '';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function () {
            btn.textContent = <%= JSON.stringify(t('live_test_copied')) %>;
          }).catch(function () {});
        }
      });
    })();
  </script>
</body>
</html>
