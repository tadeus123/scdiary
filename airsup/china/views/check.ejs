<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
</head>
<body class="cn-body">
  <%- include('partials/header') %>
  <main class="cn-wrap cn-inner">
    <h1><%= t('check_title') %></h1>
    <p class="cn-lead"><%= t('check_lead') %> <strong><%= email %></strong></p>
    <p class="cn-tade"><%= t('check_from') %></p>
    <% if (typeof demoLink !== 'undefined' && demoLink) { %>
      <section class="cn-demo-verify">
        <p class="cn-stamp cn-demo-stamp"><%= t('demo_stamp') %></p>
        <p class="cn-note"><%= t('demo_check_lead') %></p>
        <p><a class="cn-btn-ghost" href="<%= demoLink %>"><%= t('demo_check_cta') %></a></p>
      </section>
    <% } %>
    <p class="cn-proof"><%= proofLine %></p>
    <p><a class="cn-text-link" href="/airsup/china"><%= t('check_again') %></a></p>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
