<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
</head>
<body class="cn-body">
  <%- include('partials/header') %>
  <main class="cn-wrap cn-inner">
    <h1><%= companyTitle %></h1>
    <p class="cn-lead"><%= t('claim_lead') %></p>
    <% if (error) { %><p class="cn-error"><%= error %></p><% } %>
    <p class="cn-note"><%= company.website || ('https://' + company.domain) %></p>
    <p class="cn-meta"><%= company.contact_email %></p>
    <form method="post" action="/airsup/china/claim/confirm" class="cn-form">
      <input type="hidden" name="token" value="<%= token %>">
      <button type="submit" class="cn-primary"><%= t('claim_publish') %></button>
    </form>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
