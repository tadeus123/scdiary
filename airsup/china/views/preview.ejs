<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
</head>
<body class="cn-body">
  <%- include('partials/header') %>
  <main class="cn-wrap cn-inner">
    <p><a class="cn-btn-ghost" href="/airsup/china"><%= t('preview_back') %></a></p>
    <h1><%= preview.companyName || preview.domain %></h1>
    <p class="cn-lead"><%= preview.fromSite ? t('preview_from_site') : t('preview_from_domain') %></p>
    <p class="cn-price"><%= preview.website %></p>
    <%- include('partials/diagram', {
      query: preview.demo && preview.demo.chatgptBuyer,
      companyName: preview.companyName,
      domain: preview.domain,
      capabilities: (preview.capabilities && preview.capabilities.length) ? preview.capabilities : (preview.demo && preview.demo.suppliers && preview.demo.suppliers[0] && preview.demo.suppliers[0].lines) || []
    }) %>
    <form class="cn-form cn-signup" method="post" action="/airsup/china/start">
      <h2><%= t('activate') %></h2>
      <% if (error) { %>
        <p class="cn-error"><%= error %></p>
      <% } %>
      <label>
        <span><%= t('website') %></span>
        <input type="text" name="website" required value="<%= form.website || preview.website %>" autocomplete="url" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false">
      </label>
      <label>
        <span><%= t('email') %></span>
        <input type="email" name="email" required value="<%= form.email || '' %>" placeholder="<%= t('email_ph') %>" autocomplete="email" inputmode="email" autocapitalize="off" autocorrect="off" spellcheck="false">
      </label>
      <label>
        <span><%= t('contact') %></span>
        <input type="text" name="contact" value="<%= form.contact || '' %>" placeholder="<%= t('contact_ph') %>" autocomplete="name">
      </label>
      <label>
        <span><%= t('city') %></span>
        <select name="city">
          <% cities.forEach((city) => { %>
            <option value="<%= city.id %>" <%= form.city === city.id ? 'selected' : '' %>><%= lang === 'en' ? city.en : city.zh %></option>
          <% }) %>
        </select>
      </label>
      <button class="cn-btn" type="submit"><%= t('submit') %></button>
      <input type="hidden" name="source" value="<%= typeof source !== 'undefined' && source ? source : 'web' %>">
      <input type="hidden" name="locale" value="<%= lang %>">
      <p class="cn-note"><%= t('note') %></p>
    </form>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
