<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
</head>
<body class="cn-body">
  <%- include('partials/header') %>
  <main class="cn-wrap cn-inner">
    <p><a class="cn-btn-ghost" href="/airsup/china"><%= t('preview_back') %></a></p>
    <h1><%= preview.companyName || preview.domain %></h1>
    <p class="cn-note"><%= preview.website %></p>
    <form class="cn-form cn-signup" method="post" action="/airsup/china/start">
      <% if (error) { %>
        <p class="cn-error"><%= error %></p>
      <% } %>
      <label>
        <span><%= t('website') %></span>
        <input type="text" name="website" required value="<%= form.website || preview.website %>" autocomplete="url" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false">
      </label>
      <label>
        <span><%= t('email') %></span>
        <input type="email" name="email" required value="<%= form.email || '' %>" placeholder="<%= t('email_ph') %>" autocomplete="email" inputmode="email" autocapitalize="off" autocorrect="off" spellcheck="false">
      </label>
      <label>
        <span><%= t('contact') %></span>
        <input type="text" name="contact" value="<%= form.contact || '' %>" placeholder="<%= t('contact_ph') %>" autocomplete="name">
      </label>
      <button class="cn-btn" type="submit"><%= t('submit') %></button>
      <input type="hidden" name="city" value="<%= form.city || preview.cityId || 'shenzhen' %>">
      <input type="hidden" name="source" value="<%= typeof source !== 'undefined' && source ? source : 'web' %>">
      <input type="hidden" name="locale" value="<%= lang %>">
    </form>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
