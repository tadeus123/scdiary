<%
  const queryText = (typeof query !== 'undefined' && query) ? query : t('gpt_search_query');
  const companyLabel = (typeof companyName !== 'undefined' && companyName) ? companyName : t('factory_you');
  const domainLabel = (typeof domain !== 'undefined' && domain) ? domain : t('factory_domain_ex');
  const caps = (typeof capabilities !== 'undefined' && capabilities && capabilities.length)
    ? capabilities
    : [t('factory_cap1'), t('factory_cap2'), t('factory_cap3'), t('factory_cap4'), t('factory_cap5'), t('factory_cap6')];
%>
<div class="cn-diagram">
  <p class="cn-scribble cn-scribble-buyers"><%= t('scribble_buyers') %></p>
  <div class="cn-gpt-card">
    <div class="cn-gpt-head">
      <span class="cn-spark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 1.5l1.2 5.2L15.5 8 10.2 9.3 9 15.5 7.8 9.3 2.5 8l5.3-1.3L9 1.5z" fill="#5b5b5b"/></svg>
      </span>
      <span><%= t('gpt_search_title') %></span>
    </div>
    <p class="cn-sim"><%= t('sim_badge') %></p>
    <p class="cn-gpt-query"><%= queryText %></p>
    <div class="cn-gpt-search">
      <span class="cn-icon-plus" aria-hidden="true">+</span>
      <span class="cn-search-label"><%= t('gpt_search') %></span>
      <span class="cn-search-go" aria-hidden="true"></span>
    </div>
  </div>
  <svg class="cn-join" viewBox="0 0 360 64" aria-hidden="true">
    <path d="M90 2 C90 40, 180 18, 180 62" fill="none" stroke="#8a1f2c" stroke-width="1.4"/>
    <path d="M270 2 C270 40, 180 18, 180 62" fill="none" stroke="#8a1f2c" stroke-width="1.4"/>
    <path d="M174 54 l6 10 6-10" fill="#8a1f2c"/>
  </svg>
  <div class="cn-net">
    <strong><%= t('net_title') %></strong>
    <span><%= t('net_sub') %></span>
  </div>
  <svg class="cn-join cn-join-one" viewBox="0 0 360 40" aria-hidden="true">
    <path d="M180 0 v28" fill="none" stroke="#8a1f2c" stroke-width="1.4"/>
    <path d="M174 22 l6 10 6-10" fill="#8a1f2c"/>
  </svg>
  <div class="cn-factory-card">
    <div class="cn-factory-top">
      <span class="cn-factory-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M4 22V10l6-3 5 3v-2l5-2 4 2v14H4z" stroke="#7A1E2B" stroke-width="1.4"/><path d="M8 22v-6h4v6M16 22v-4h4v4" stroke="#7A1E2B" stroke-width="1.4"/></svg>
      </span>
      <div>
        <p class="cn-factory-name"><%= companyLabel %></p>
        <p class="cn-factory-domain"><%= domainLabel %></p>
      </div>
      <span class="cn-verified"><%= t('factory_verified') %></span>
    </div>
    <ul class="cn-caps">
      <% caps.slice(0, 6).forEach((cap) => { %>
        <li><%= cap %></li>
      <% }) %>
    </ul>
    <p class="cn-ready"><%= t('factory_ready') %></p>
  </div>
  <p class="cn-scribble cn-scribble-factory"><%= t('scribble_factory') %></p>
</div>
