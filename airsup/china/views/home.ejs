<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
</head>
<body class="cn-body">
  <%- include('partials/header') %>
  <main class="cn-main cn-home">
    <section class="cn-hero-copy">
      <h1><%= t('hero') %></h1>
      <p class="cn-lead"><%= t('lead') %></p>
      <p class="cn-price"><%= t('price') %></p>
    </section>

    <ol class="cn-chain">
      <li><%= t('chain_site') %></li>
      <li><%= t('chain_end') %></li>
      <li><%= t('chain_ai') %></li>
    </ol>

    <%- include('partials/demo', { demo: genericDemo }) %>

    <form class="cn-form cn-preview-form" method="post" action="/airsup/china/preview">
      <h2><%= t('preview_title') %></h2>
      <p class="cn-note"><%= t('preview_lead') %></p>
      <% if (error) { %>
        <p class="cn-error"><%= error %></p>
      <% } %>
      <label>
        <span><%= t('website') %></span>
        <input type="text" name="website" required value="<%= form.website || '' %>" placeholder="<%= t('website_only_ph') %>" autocomplete="url" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false">
      </label>
      <button type="submit"><%= t('preview_cta') %></button>
      <input type="hidden" name="source" value="<%= typeof source !== 'undefined' && source ? source : 'web' %>">
      <input type="hidden" name="locale" value="<%= lang %>">
    </form>

    <ul class="cn-gets">
      <li><%= t('get1') %></li>
      <li><%= t('get2') %></li>
      <li><%= t('get3') %></li>
    </ul>
    <p class="cn-proof"><%= proofLine %></p>
    <p class="cn-tade"><%= t('in_china') %></p>

    <ol class="cn-steps">
      <li><span>01</span><p><%= t('step1') %></p></li>
      <li><span>02</span><p><%= t('step2') %></p></li>
      <li><span>03</span><p><%= t('step3') %></p></li>
      <li><span>04</span><p><%= t('step4') %></p></li>
    </ol>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
