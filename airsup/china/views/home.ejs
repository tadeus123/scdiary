<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
</head>
<body class="cn-body cn-landing">
  <%- include('partials/header') %>
  <main>
    <section class="cn-hero">
      <div class="cn-hero-grid">
        <div class="cn-hero-copy">
          <p class="cn-scribble cn-scribble-hero"><%= t('scribble_hero') %></p>
          <h1><%= t('hero_before') %><span class="cn-gpt-word">ChatGPT</span><%= t('hero_after') %></h1>
          <p class="cn-lead"><%= t('lead') %></p>
          <p class="cn-price"><%= t('price') %></p>
          <div class="cn-hero-cta">
            <a class="cn-btn" href="#activate"><%= t('cta_activate') %> →</a>
            <a class="cn-btn-ghost" href="#how"><%= t('cta_how') %> →</a>
          </div>
          <p class="cn-stamp-line"><%= t('scribble_same_cn') %></p>
        </div>
        <%- include('partials/diagram') %>
      </div>
    </section>

    <section class="cn-band" id="why">
      <div class="cn-wrap">
        <p class="cn-scribble cn-scribble-right"><%= t('scribble_same') %></p>
        <h2><%= t('why_title') %></h2>
        <p class="cn-lead cn-lead-center"><%= t('why_lead') %></p>
        <div class="cn-flow-row">
          <article>
            <span class="cn-flow-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="12" cy="12" r="7" stroke="#7A1E2B" stroke-width="1.6"/><path d="M17 17l6 6" stroke="#7A1E2B" stroke-width="1.6" stroke-linecap="round"/></svg></span>
            <h3><%= t('flow1_t') %></h3>
            <p><%= t('flow1_d') %></p>
          </article>
          <article>
            <span class="cn-flow-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="5" y="7" width="18" height="14" rx="2" stroke="#7A1E2B" stroke-width="1.6"/><path d="M9 12h10M9 16h6" stroke="#7A1E2B" stroke-width="1.6" stroke-linecap="round"/></svg></span>
            <h3><%= t('flow2_t') %></h3>
            <p><%= t('flow2_d') %></p>
          </article>
          <article>
            <span class="cn-flow-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M6 20V9l8-3 8 3v11" stroke="#7A1E2B" stroke-width="1.6"/><path d="M10 20v-6h8v6" stroke="#7A1E2B" stroke-width="1.6"/></svg></span>
            <h3><%= t('flow3_t') %></h3>
            <p><%= t('flow3_d') %></p>
          </article>
          <article>
            <span class="cn-flow-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M7 8h14v12H7z" stroke="#7A1E2B" stroke-width="1.6"/><path d="M10 12h8M10 16h5" stroke="#7A1E2B" stroke-width="1.6" stroke-linecap="round"/></svg></span>
            <h3><%= t('flow4_t') %></h3>
            <p><%= t('flow4_d') %></p>
          </article>
        </div>
      </div>
    </section>

    <section class="cn-wrap cn-growth" id="growth">
      <% var launchDay = proof && proof.series && proof.series[0] && proof.series[0].day; %>
      <h2>
        <%= t('growth_title') %>
        <% if (launchDay) { %>
          <span class="cn-growth-date"><%= t('growth_launch') %> <%= formatChartDay(launchDay) %></span>
        <% } %>
      </h2>
      <p class="cn-pitch"><%= t('pitch_line') %></p>
      <p class="cn-growth-adopt"><%= t('growth_adoption') %></p>
      <% if (proof && proof.chart && proof.live > 0) { %>
      <figure class="cn-chart">
        <figcaption><%= t('growth_chart') %> · <%= proof.live %></figcaption>
        <svg viewBox="0 0 <%= proof.chart.width %> <%= proof.chart.height %>" role="img" aria-label="<%= t('growth_chart') %>">
          <polygon class="cn-chart-fill" points="<%= proof.chart.area %>"></polygon>
          <polyline class="cn-chart-line" fill="none" points="<%= proof.chart.line %>"></polyline>
          <% proof.chart.yTicks.forEach((tick) => { %>
            <text class="cn-chart-y" x="<%= proof.chart.left - 8 %>" y="<%= tick.y + 4 %>" text-anchor="end"><%= tick.label %></text>
          <% }) %>
          <% proof.chart.labels.forEach((label) => { %>
            <text class="cn-chart-x" x="<%= label.x %>" y="<%= proof.chart.height - 12 %>" text-anchor="<%= label.first ? 'start' : (label.last ? 'end' : 'middle') %>"><%= label.first ? t('growth_launch') : formatChartDay(label.day) %></text>
          <% }) %>
        </svg>
        <p class="cn-chart-axes"><span><%= t('growth_axis_y') %></span><span><%= t('growth_axis_x') %></span></p>
      </figure>
      <% } %>
      <% if (proof && proof.recent && proof.recent.length) { %>
        <h3><%= t('peers_title') %></h3>
        <p class="cn-note"><%= t('peers_lead') %></p>
        <div class="cn-live-scroll">
          <table class="cn-live-table">
            <thead>
              <tr>
                <th><%= t('peers_col_name') %></th>
                <th><%= t('peers_col_site') %></th>
                <th><%= t('peers_col_cat') %></th>
              </tr>
            </thead>
            <tbody>
              <% proof.recent.forEach((row) => { %>
                <tr>
                  <td><%= lang === 'en' ? (row.name || row.name_zh) : (row.name_zh || row.name) %></td>
                  <td><a href="<%= row.website || ('https://' + row.domain) %>" rel="noopener noreferrer" target="_blank"><%= row.domain %></a></td>
                  <td><%= lang === 'en' ? (row.niche_en || row.niche) : (row.niche_zh || row.niche) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="cn-wrap cn-activate-steps" id="how">
      <p class="cn-scribble cn-scribble-right"><%= t('scribble_steps') %></p>
      <h2><%= t('plugin_title') %></h2>
      <p class="cn-lead"><%= t('plugin_lead') %></p>
      <h2><%= t('act_title') %></h2>
      <p class="cn-lead"><%= t('act_lead') %></p>
      <ol class="cn-four">
        <li><span>01</span><h3><%= t('act1_t') %></h3><p><%= t('act1_d') %></p></li>
        <li><span>02</span><h3><%= t('act2_t') %></h3><p><%= t('act2_d') %></p></li>
        <li><span>03</span><h3><%= t('act3_t') %></h3><p><%= t('act3_d') %></p></li>
        <li><span>04</span><h3><%= t('act4_t') %></h3><p><%= t('act4_d') %></p></li>
      </ol>
    </section>

    <section class="cn-wrap cn-control" id="control">
      <div class="cn-control-grid">
        <div>
          <h2><%= t('ctrl_title') %></h2>
          <p class="cn-lead"><%= t('ctrl_lead') %></p>
          <a class="cn-btn-ghost" href="#activate"><%= t('ctrl_more') %> →</a>
        </div>
        <div class="cn-toggle-card">
          <p class="cn-toggle-title"><%= t('ctrl_card') %></p>
          <% ['ctrl_row1','ctrl_row2','ctrl_row3','ctrl_row4','ctrl_row5','ctrl_row6'].forEach((key, i) => { %>
            <div class="cn-toggle-row">
              <span><%= t(key) %></span>
              <span class="cn-switch <%= i === 4 ? 'is-off' : 'is-on' %>" aria-hidden="true"></span>
            </div>
          <% }) %>
          <p class="cn-scribble cn-scribble-lock"><%= t('scribble_lock') %></p>
        </div>
      </div>
      <p class="cn-scribble cn-scribble-control"><%= t('scribble_control') %></p>
    </section>

    <section class="cn-wrap cn-examples" id="examples">
      <p class="cn-scribble cn-scribble-right"><%= t('scribble_examples') %></p>
      <h2><%= t('ex_title') %> <span class="cn-pill"><%= t('ex_badge') %></span></h2>
      <p class="cn-lead"><%= t('ex_lead') %></p>
      <div class="cn-ex-grid">
        <article>
          <svg class="cn-ex-ico" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="6" y="10" width="28" height="20" rx="2" stroke="#7A1E2B" stroke-width="1.4"/><path d="M12 16h8M12 20h16M12 24h10" stroke="#7A1E2B" stroke-width="1.4"/></svg>
          <h3><%= t('ex_cnc_t') %></h3>
          <p><%= t('ex_cnc_d') %></p>
        </article>
        <article>
          <svg class="cn-ex-ico" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="8" y="8" width="24" height="24" rx="2" stroke="#7A1E2B" stroke-width="1.4"/><circle cx="16" cy="16" r="2" fill="#7A1E2B"/><circle cx="24" cy="16" r="2" fill="#7A1E2B"/><circle cx="16" cy="24" r="2" fill="#7A1E2B"/><circle cx="24" cy="24" r="2" fill="#7A1E2B"/></svg>
          <h3><%= t('ex_pcba_t') %></h3>
          <p><%= t('ex_pcba_d') %></p>
        </article>
        <article>
          <svg class="cn-ex-ico" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M10 28h20l-3-12H13L10 28z" stroke="#7A1E2B" stroke-width="1.4"/><path d="M16 16V10h8v6" stroke="#7A1E2B" stroke-width="1.4"/></svg>
          <h3><%= t('ex_inj_t') %></h3>
          <p><%= t('ex_inj_d') %></p>
        </article>
      </div>
    </section>

    <section class="cn-wrap cn-faq" id="faq">
      <h2><%= t('faq_title') %></h2>
      <details><summary><%= t('faq1_q') %></summary><p><%= t('faq1_a') %></p></details>
      <details><summary><%= t('faq2_q') %></summary><p><%= t('faq2_a') %></p></details>
      <details><summary><%= t('faq3_q') %></summary><p><%= t('faq3_a') %></p></details>
      <details><summary><%= t('faq4_q') %></summary><p><%= t('faq4_a') %></p></details>
    </section>

    <section class="cn-wrap cn-activate" id="activate">
      <form class="cn-form cn-preview-form" method="post" action="/airsup/china/preview">
        <h2><%= t('activate_title') %></h2>
        <p class="cn-lead"><%= t('activate_lead') %></p>
        <% if (error) { %>
          <p class="cn-error"><%= error %></p>
        <% } %>
        <label>
          <span><%= t('website') %></span>
          <input type="text" name="website" required value="<%= form.website || '' %>" placeholder="<%= t('website_only_ph') %>" autocomplete="url" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false">
        </label>
        <button class="cn-btn" type="submit"><%= t('preview_cta') %> →</button>
        <input type="hidden" name="source" value="<%= typeof source !== 'undefined' && source ? source : 'web' %>">
        <input type="hidden" name="locale" value="<%= lang %>">
        <p class="cn-note"><%= t('preview_lead') %></p>
      </form>
    </section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
