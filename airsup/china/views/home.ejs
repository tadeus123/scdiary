<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head') %>
</head>
<body class="cn-body cn-landing">
  <%- include('partials/header') %>
  <main>
    <section class="cn-hero" id="top">
      <div class="cn-hero-grid">
        <div class="cn-hero-copy">
          <h1><%= t('hero_before') %><span class="cn-gpt-word">ChatGPT</span><%= t('hero_after') %></h1>
          <p class="cn-lead"><%= t('lead_short') %></p>
          <% if (typeof proofLine !== 'undefined' && proofLine) { %>
            <p class="cn-proof"><%= proofLine %></p>
          <% } %>
          <p class="cn-note"><%= t('hero_openai_note') %></p>
          <form class="cn-form cn-preview-form cn-hero-form" method="post" action="/airsup/china/preview">
            <% if (error) { %>
              <p class="cn-error"><%= error %></p>
            <% } %>
            <label>
              <span><%= t('website') %></span>
              <input type="text" name="website" required value="<%= form.website || '' %>" placeholder="<%= t('website_only_ph') %>" autocomplete="url" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false">
            </label>
            <button class="cn-btn" type="submit"><%= t('preview_cta') %> →</button>
            <input type="hidden" name="source" value="<%= typeof source !== 'undefined' && source ? source : 'web' %>">
            <input type="hidden" name="locale" value="<%= lang %>">
          </form>
          <ul class="cn-hero-trust">
            <li><%= t('hero_trust_1') %></li>
            <li><%= t('hero_trust_2') %></li>
            <li><%= t('hero_trust_3') %></li>
          </ul>
        </div>
        <%- include('partials/diagram') %>
      </div>
    </section>

    <section class="cn-wrap" id="proof" aria-labelledby="proof-title">
      <h2 id="proof-title"><%= t('proof_title') %></h2>
      <p class="cn-lead"><%= t('proof_lead') %></p>
      <figure class="cn-plugin-video">
        <video controls playsinline preload="none" poster="/airsup/china/buyer-plugin.jpg" aria-label="<%= t('proof_title') %>">
          <source src="/airsup/china/buyer-plugin.mp4" type="video/mp4">
        </video>
      </figure>
    </section>

    <section class="cn-wrap" id="what" aria-labelledby="what-title">
      <h2 id="what-title"><%= t('what_title') %></h2>
      <ul class="cn-note cn-what-list">
        <li><%= t('what_not_1') %></li>
        <li><%= t('what_not_2') %></li>
        <li><%= t('what_not_3') %></li>
      </ul>
      <p class="cn-lead"><%= t('what_is') %></p>
    </section>

    <section class="cn-wrap" id="factories" aria-labelledby="factories-title">
      <h2 id="factories-title"><%= t('factories_title_before') %><%= (proof && proof.live) || 0 %><%= t('factories_title_after') %></h2>
      <p class="cn-note"><%= t('peers_lead') %></p>
      <% if (proof && proof.recent && proof.recent.length) { %>
        <%
          var cards = proof.recent.slice(0, 6);
          var liveCats = [];
          var liveCatMeta = {};
          proof.recent.forEach(function (row) {
            var slug = String(row.niche || '').trim();
            if (!slug || liveCatMeta[slug]) return;
            liveCatMeta[slug] = row;
            liveCats.push(slug);
          });
        %>
        <% if (liveCats.length) { %>
          <div class="cn-cat-filters" id="cn-cat-filters" role="group" aria-label="<%= t('peers_col_cat') %>">
            <button type="button" class="cn-cat-chip is-on" data-filter=""><%= t('filter_all') %></button>
            <% liveCats.forEach(function (slug) { %>
              <% var meta = liveCatMeta[slug]; %>
              <button type="button" class="cn-cat-chip" data-filter="<%= slug %>"><%= lang === 'en' ? (meta.niche_en || slug) : (meta.niche_zh || slug) %></button>
            <% }) %>
          </div>
        <% } %>
        <div class="cn-factory-cards">
          <% cards.forEach(function (row) { %>
            <article class="cn-factory-card" data-niche="<%= row.niche || '' %>">
              <strong><%= lang === 'en' ? (row.name || row.name_zh || row.domain) : (row.name_zh || row.name || row.domain) %></strong>
              <p><a href="<%= row.website || ('https://' + row.domain) %>" rel="noopener noreferrer" target="_blank"><%= row.domain %></a></p>
              <p class="cn-meta"><%= lang === 'en' ? (row.niche_en || row.niche) : (row.niche_zh || row.niche) %></p>
            </article>
          <% }) %>
        </div>
        <details class="cn-more cn-factories-all" open>
          <summary><%= t('factories_view_all_before') %><%= proof.live || proof.recent.length %><%= t('factories_view_all_after') %></summary>
          <div class="cn-live-scroll">
            <table class="cn-live-table">
              <thead>
                <tr>
                  <th><%= t('peers_col_name') %></th>
                  <th><%= t('peers_col_site') %></th>
                  <th><%= t('peers_col_cat') %></th>
                </tr>
              </thead>
              <tbody>
                <% proof.recent.forEach(function (row) { %>
                  <tr data-niche="<%= row.niche || '' %>">
                    <td><%= lang === 'en' ? (row.name || row.name_zh) : (row.name_zh || row.name) %></td>
                    <td><a href="<%= row.website || ('https://' + row.domain) %>" rel="noopener noreferrer" target="_blank"><%= row.domain %></a></td>
                    <td><%= lang === 'en' ? (row.niche_en || row.niche) : (row.niche_zh || row.niche) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </details>
        <script>
        (function () {
          var root = document.getElementById('factories');
          if (!root) return;
          var chips = root.querySelectorAll('.cn-cat-chip');
          var items = root.querySelectorAll('[data-niche]');
          if (!chips.length) return;
          function apply(slug) {
            var want = String(slug || '');
            chips.forEach(function (ch) {
              ch.classList.toggle('is-on', String(ch.getAttribute('data-filter') || '') === want);
            });
            items.forEach(function (el) {
              var match = !want || String(el.getAttribute('data-niche') || '') === want;
              el.hidden = !match;
            });
            try {
              var url = new URL(window.location.href);
              if (want) url.searchParams.set('category', want);
              else url.searchParams.delete('category');
              history.replaceState({}, '', url.pathname + url.search + url.hash);
            } catch (e) {}
          }
          chips.forEach(function (ch) {
            ch.addEventListener('click', function () {
              apply(ch.getAttribute('data-filter') || '');
            });
          });
          var initial = '';
          try { initial = new URLSearchParams(window.location.search).get('category') || ''; } catch (e) {}
          if (initial) apply(initial);
        })();
        </script>
      <% } %>
      <% if (proof && proof.chart && proof.live > 0) { %>
      <figure class="cn-chart" id="cn-growth-chart" data-lang="<%= lang %>" data-tip-day="<%= t('growth_tip_day') %>" data-tip-live="<%= t('growth_tip_live') %>" data-points='<%= JSON.stringify(proof.chart.points).replace(/'/g, "&#39;") %>'>
        <figcaption><%= t('growth_chart') %></figcaption>
        <p class="cn-chart-hint"><%= t('growth_tip_hint') %></p>
        <div class="cn-chart-stage">
          <svg viewBox="0 0 <%= proof.chart.width %> <%= proof.chart.height %>" role="img" aria-label="<%= t('growth_chart') %>">
            <polygon class="cn-chart-fill" points="<%= proof.chart.area %>"></polygon>
            <polyline class="cn-chart-line" fill="none" points="<%= proof.chart.line %>"></polyline>
            <% proof.chart.yTicks.forEach((tick) => { %>
              <text class="cn-chart-y" x="<%= proof.chart.left - 8 %>" y="<%= tick.y + 4 %>" text-anchor="end"><%= tick.label %></text>
            <% }) %>
            <% proof.chart.labels.forEach((label) => { %>
              <% if (label.first) { %>
                <text class="cn-chart-x" x="<%= label.x %>" y="<%= proof.chart.height - 26 %>" text-anchor="start"><%= t('growth_launch') %></text>
                <text class="cn-chart-x" x="<%= label.x %>" y="<%= proof.chart.height - 10 %>" text-anchor="start"><%= formatChartDay(label.day) %></text>
              <% } else { %>
                <text class="cn-chart-x" x="<%= label.x %>" y="<%= proof.chart.height - 12 %>" text-anchor="<%= label.last ? 'end' : 'middle' %>"><%= formatChartDay(label.day) %></text>
              <% } %>
            <% }) %>
            <g class="cn-chart-focus">
              <line class="cn-chart-guide" x1="0" x2="0" y1="<%= proof.chart.top %>" y2="<%= proof.chart.baseline %>"></line>
              <circle class="cn-chart-dot" cx="0" cy="0" r="5"></circle>
            </g>
          </svg>
          <button type="button" class="cn-chart-hit" aria-label="<%= t('growth_tip_hint') %>"></button>
          <div class="cn-chart-tip" hidden>
            <strong class="cn-chart-tip-day"></strong>
            <span class="cn-chart-tip-count"></span>
          </div>
        </div>
        <p class="cn-chart-axes"><span><%= t('growth_axis_y') %></span><span><%= t('growth_axis_x') %></span></p>
      </figure>
      <script>
      (function () {
        var root = document.getElementById('cn-growth-chart');
        if (!root) return;
        var points;
        try { points = JSON.parse(root.getAttribute('data-points') || '[]'); } catch (e) { return; }
        if (!points.length) return;
        var svg = root.querySelector('svg');
        var hit = root.querySelector('.cn-chart-hit');
        var focus = root.querySelector('.cn-chart-focus');
        var guide = root.querySelector('.cn-chart-guide');
        var dot = root.querySelector('.cn-chart-dot');
        var tip = root.querySelector('.cn-chart-tip');
        var tipDay = root.querySelector('.cn-chart-tip-day');
        var tipCount = root.querySelector('.cn-chart-tip-count');
        var stage = root.querySelector('.cn-chart-stage');
        var lang = root.getAttribute('data-lang') === 'en' ? 'en' : 'zh';
        var tipLive = root.getAttribute('data-tip-live') || '';
        var tipDayLabel = root.getAttribute('data-tip-day') || '';
        var active = false;
        var vb = svg.viewBox.baseVal;

        function svgXFromClient(clientX) {
          var rect = svg.getBoundingClientRect();
          if (!rect.width) return points[0].x;
          return ((clientX - rect.left) / rect.width) * vb.width;
        }

        function nearest(clientX) {
          var x = svgXFromClient(clientX);
          var best = points[0];
          var bestDist = Math.abs(best.x - x);
          for (var i = 1; i < points.length; i++) {
            var d = Math.abs(points[i].x - x);
            if (d < bestDist) { best = points[i]; bestDist = d; }
          }
          return best;
        }

        function placeTip(point) {
          var rect = svg.getBoundingClientRect();
          var stageRect = stage.getBoundingClientRect();
          var px = (point.x / vb.width) * rect.width;
          var py = (point.y / vb.height) * rect.height;
          tip.hidden = false;
          tip.style.left = Math.max(8, Math.min(stageRect.width - tip.offsetWidth - 8, px - tip.offsetWidth / 2)) + 'px';
          tip.style.top = Math.max(8, py - tip.offsetHeight - 14) + 'px';
        }

        function show(point) {
          active = true;
          root.classList.add('is-scrubbing');
          focus.classList.add('is-on');
          guide.setAttribute('x1', point.x);
          guide.setAttribute('x2', point.x);
          dot.setAttribute('cx', point.x);
          dot.setAttribute('cy', point.y);
          var day = lang === 'en' ? point.label_en : point.label_zh;
          tipDay.textContent = (tipDayLabel ? tipDayLabel + ' ' : '') + day;
          tipCount.textContent = point.count + ' ' + tipLive;
          placeTip(point);
        }

        function hide() {
          active = false;
          root.classList.remove('is-scrubbing');
          focus.classList.remove('is-on');
          tip.hidden = true;
        }

        function fromEvent(event) {
          var clientX = event.clientX;
          if ((clientX == null || clientX === 0) && event.touches && event.touches[0]) {
            clientX = event.touches[0].clientX;
          }
          if ((clientX == null) && event.changedTouches && event.changedTouches[0]) {
            clientX = event.changedTouches[0].clientX;
          }
          return nearest(clientX);
        }

        hit.addEventListener('pointerdown', function (event) {
          event.preventDefault();
          hit.setPointerCapture(event.pointerId);
          show(fromEvent(event));
        });
        hit.addEventListener('pointermove', function (event) {
          if (!active) return;
          show(fromEvent(event));
        });
        hit.addEventListener('pointerup', function () { /* keep bubble visible while scrubbing */ });
        hit.addEventListener('keydown', function (event) {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          show(points[Math.floor(points.length / 2)]);
        });
        document.addEventListener('pointerdown', function (event) {
          if (!active) return;
          if (root.contains(event.target)) return;
          hide();
        });
      })();
      </script>
      <% } %>
    </section>

    <section class="cn-wrap" id="rfq-path" aria-labelledby="rfq-title">
      <h2 id="rfq-title"><%= t('rfq_title') %></h2>
      <p class="cn-lead"><%= t('rfq_lead') %></p>
      <ol class="cn-four cn-three">
        <li><span>01</span><h3><%= t('rfq_1') %></h3><p><%= t('rfq_2') %></p></li>
        <li><span>02</span><h3><%= t('rfq_3') %></h3><p><%= t('rfq_4') %></p></li>
        <li><span>03</span><h3><%= t('rfq_5') %></h3><p><%= t('rfq_6') %></p></li>
      </ol>
    </section>

    <section class="cn-wrap" id="trust" aria-labelledby="trust-title">
      <h2 id="trust-title"><%= t('trust_title') %></h2>
      <ul class="cn-note">
        <li><%= t('trust_1') %></li>
        <li><%= t('trust_2') %></li>
        <li><%= t('trust_3') %></li>
        <li><%= t('trust_4') %></li>
        <li><%= t('trust_5') %></li>
        <li><%= t('trust_6') %></li>
      </ul>
      <p><a class="cn-text-link" href="/airsup/china/privacy"><%= t('privacy_link') %></a></p>
    </section>

    <section class="cn-wrap cn-faq" id="faq">
      <h2><%= t('faq_title') %></h2>
      <details><summary><%= t('faq_openai_q') %></summary><p><%= t('faq_openai_a') %></p></details>
      <details><summary><%= t('faq_ads_q') %></summary><p><%= t('faq_ads_a') %></p></details>
      <details><summary><%= t('faq_install_q') %></summary><p><%= t('faq_install_a') %></p></details>
      <details><summary><%= t('faq_free_q') %></summary><p><%= t('faq_free_a') %></p></details>
      <details><summary><%= t('faq_data_q') %></summary><p><%= t('faq_data_a') %></p></details>
      <details><summary><%= t('faq_buyersee_q') %></summary><p><%= t('faq_buyersee_a') %></p></details>
      <details><summary><%= t('faq_edit_q') %></summary><p><%= t('faq_edit_a') %></p></details>
      <details><summary><%= t('faq_offline_q') %></summary><p><%= t('faq_offline_a') %></p></details>
      <details><summary><%= t('faq_buyerid_q') %></summary><p><%= t('faq_buyerid_a') %></p></details>
      <details><summary><%= t('faq_where_q') %></summary><p><%= t('faq_where_a') %></p></details>
      <details><summary><%= t('faq_noemail_q') %></summary><p><%= t('faq_noemail_a') %></p></details>
      <details><summary><%= t('faq_company_q') %></summary><p><%= t('faq_company_a') %></p></details>
