    <section class="cn-wrap cn-activate" id="activate">
      <form class="cn-form cn-preview-form" method="post" action="/airsup/china/preview">
        <h2><%= t('activate_title') %></h2>
        <p class="cn-lead"><%= t('activate_lead') %></p>
        <label>
          <span><%= t('website') %></span>
          <input type="text" name="website" required value="<%= form.website || '' %>" placeholder="<%= t('website_only_ph') %>" autocomplete="url" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false">
        </label>
        <button class="cn-btn" type="submit"><%= t('preview_cta') %> →</button>
        <input type="hidden" name="source" value="<%= typeof source !== 'undefined' && source ? source : 'web' %>">
        <input type="hidden" name="locale" value="<%= lang %>">
        <p class="cn-note"><%= t('note') %></p>
        <p class="cn-note"><a class="cn-text-link" href="mailto:tademehl@gmail.com"><%= t('manual_email_cta') %></a></p>
      </form>
    </section>
  </main>
  <%- include('partials/footer') %>
  <div class="cn-login-modal" id="cn-login-modal" hidden aria-hidden="true">
    <div class="cn-login-card" role="dialog" aria-modal="true" aria-labelledby="cn-login-title">
      <h2 id="cn-login-title"><%= t('login_title') %></h2>
      <p class="cn-login-lead"><%= t('login_lead') %></p>
      <div class="cn-login-msg" id="cn-login-msg" role="status"></div>
      <label for="cn-login-email"><%= t('login_email') %></label>
      <input type="email" id="cn-login-email" autocomplete="email" placeholder="you@factory.com">
      <div id="cn-login-code-wrap" hidden>
        <label for="cn-login-code"><%= t('login_code') %></label>
        <input type="text" id="cn-login-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456">
      </div>
      <div class="cn-login-actions">
        <button type="button" class="cn-btn-ghost" id="cn-login-cancel"><%= t('login_cancel') %></button>
        <button type="button" class="cn-btn" id="cn-login-go"><%= t('login_send') %></button>
      </div>
    </div>
  </div>
  <script>
  (function () {
    var openBtn = document.getElementById('cn-header-login');
    var modal = document.getElementById('cn-login-modal');
    if (!openBtn || !modal) return;
    var msg = document.getElementById('cn-login-msg');
    var emailEl = document.getElementById('cn-login-email');
    var codeEl = document.getElementById('cn-login-code');
    var codeWrap = document.getElementById('cn-login-code-wrap');
    var go = document.getElementById('cn-login-go');
    var cancel = document.getElementById('cn-login-cancel');
    var step = 'email';
    var copy = {
      send: <%- JSON.stringify(t('login_send')) %>,
      verify: <%- JSON.stringify(t('login_verify')) %>,
      sent: <%- JSON.stringify(t('login_sent')) %>,
      busy: <%- JSON.stringify(t('login_busy')) %>
    };
    function openModal() {
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cn-login-open');
      step = 'email';
      codeWrap.hidden = true;
      go.textContent = copy.send;
      msg.textContent = '';
      emailEl.focus();
    }
    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cn-login-open');
    }
    openBtn.addEventListener('click', function (e) {
      e.preventDefault();
      openModal();
    });
    cancel.addEventListener('click', closeModal);
    emailEl.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); go.click(); }
    });
    codeEl.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); go.click(); }
    });
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
    go.addEventListener('click', async function () {
      msg.textContent = '';
      go.disabled = true;
      var prev = go.textContent;
      go.textContent = copy.busy;
      try {
        if (step === 'email') {
          var res = await fetch('/airsup/dashboard/api/login/request', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ email: String(emailEl.value || '').trim() }),
          });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok) throw new Error(data.error || 'request');
          step = 'code';
          codeWrap.hidden = false;
          go.textContent = copy.verify;
          msg.textContent = copy.sent;
          codeEl.focus();
        } else {
          var res2 = await fetch('/airsup/dashboard/api/login/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              email: String(emailEl.value || '').trim(),
              code: String(codeEl.value || '').trim(),
            }),
          });
          var data2 = await res2.json().catch(function () { return {}; });
          if (!res2.ok) throw new Error(data2.error || 'verify');
          window.location.href = data2.redirect || '/airsup/dashboard';
          return;
        }
      } catch (err) {
        msg.textContent = err && err.message ? err.message : 'Error';
        go.textContent = step === 'email' ? copy.send : copy.verify;
      } finally {
        go.disabled = false;
        if (step === 'email' && go.textContent === copy.busy) go.textContent = prev;
      }
    });
  })();
  </script>
</body>
</html>
