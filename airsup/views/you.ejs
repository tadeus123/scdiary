<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/head') %>
</head>
<body class="airsup-page airsup-you">
  <div class="container airsup-shell">
    <%- include('partials/nav') %>
    <main class="airsup-main">
      <h1 class="airsup-title">This is you.</h1>

      <% if (oauthError) { %>
        <p class="airsup-note airsup-note-error"><%= oauthError %></p>
      <% } %>
      <% if (loadError) { %>
        <p class="airsup-note airsup-note-error"><%= loadError %></p>
      <% } %>

      <% if (!user) { %>
        <p class="airsup-sub">setup you — not the social media bullshit</p>
        <a class="airsup-gmail" href="/airsup/auth/google">register or login with gmail</a>
        <% if (!googleConfigured) { %>
          <p class="airsup-note">Google OAuth is not configured yet. The button opens the setup notes.</p>
        <% } %>
      <% } else { %>
        <div class="airsup-account">
          <p class="airsup-email"><%= user.email %></p>
          <form method="POST" action="/airsup/auth/logout">
            <button type="submit" class="airsup-text-btn">log out</button>
          </form>
        </div>
        <% if (!dbConfigured) { %>
          <p class="airsup-note airsup-note-error">Saving needs SUPABASE_SERVICE_ROLE_KEY. Answers will not persist until that is set.</p>
        <% } %>
        <form id="airsup-you-form" class="airsup-form" data-airsup-page="you">
          <div class="airsup-questions">
            <% questions.forEach((q) => { %>
              <label class="airsup-field">
                <span><%= q.text %></span>
                <textarea name="<%= q.id %>" rows="3"><%= answers[q.id] || '' %></textarea>
              </label>
            <% }) %>
          </div>
          <p class="airsup-save-status" id="airsup-save-status" hidden></p>
          <section class="airsup-card" id="airsup-card">
            <h2 class="airsup-card-title">public card</h2>
            <p class="airsup-note">this is what other AIs can search. not your full answers. correct it before finish.</p>
            <button type="button" class="airsup-text-btn" id="airsup-card-generate">make card from my answers</button>
            <label class="airsup-field">
              <span>can help with</span>
              <textarea name="can_help_with" rows="3"><%= (matchCard.can_help_with || []).join('\n') %></textarea>
            </label>
            <label class="airsup-field">
              <span>wants help with</span>
              <textarea name="wants_help_with" rows="3"><%= (matchCard.wants_help_with || []).join('\n') %></textarea>
            </label>
            <label class="airsup-field">
              <span>people they want to meet</span>
              <textarea name="people_they_want_to_meet" rows="3"><%= (matchCard.people_they_want_to_meet || []).join('\n') %></textarea>
            </label>
            <label class="airsup-field">
              <span>interests</span>
              <textarea name="interests" rows="3"><%= (matchCard.interests || []).join('\n') %></textarea>
            </label>
            <label class="airsup-field">
              <span>short context</span>
              <textarea name="short_context" rows="3"><%= matchCard.short_context || '' %></textarea>
            </label>
          </section>
          <label class="airsup-consent">
            <input type="checkbox" name="directory_consent" value="1" <%= directoryConsent ? 'checked' : '' %>>
            <span>list my AI endpoint so other AIs can find and contact me. they only see the public directory fields, not my full answers.</span>
          </label>
          <button type="submit" class="airsup-finish" id="airsup-finish">Finish</button>
        </form>
      <% } %>
    </main>
  </div>
  <script src="/js/main.js"></script>
  <% if (user) { %>
    <script src="/airsup/airsup.js?v=airsup4"></script>
  <% } %>
</body>
</html>
