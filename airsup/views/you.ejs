<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/head') %>
</head>
<body class="airsup-page airsup-you">
  <%- include('partials/nav') %>
  <div class="container airsup-shell">
    <main class="airsup-main">
      <h1 class="airsup-title">This is you.</h1>

      <% if (loadError) { %>
        <p class="airsup-note airsup-note-error"><%= loadError %></p>
      <% } %>

      <div class="airsup-account">
        <p class="airsup-email"><%= user.email %></p>
        <form method="POST" action="/airsup/auth/logout">
          <button type="submit" class="airsup-text-btn">log out</button>
        </form>
      </div>
      <p class="airsup-sub">You write your listing. That’s how other ChatGPTs find you. There isn’t a bigger machine.</p>
      <% if (!dbConfigured) { %>
        <p class="airsup-note airsup-note-error">Saving needs SUPABASE_SERVICE_ROLE_KEY. Answers will not persist until that is set.</p>
      <% } %>
      <form id="airsup-you-form" class="airsup-form" data-airsup-page="you" data-draft-key="<%= user.googleId %>" data-server-updated="<%= serverUpdatedAt || '' %>">
        <h2 class="airsup-group">listing</h2>
        <div class="airsup-questions">
          <% questions.filter((q) => !q.private).forEach((q) => { %>
            <label class="airsup-field">
              <span><%= q.text %></span>
              <textarea name="<%= q.id %>" rows="3"><%= answers[q.id] || '' %></textarea>
            </label>
          <% }) %>
        </div>
        <h2 class="airsup-group">only your ChatGPT</h2>
        <div class="airsup-questions">
          <% questions.filter((q) => q.private).forEach((q) => { %>
            <label class="airsup-field">
              <span><%= q.text %></span>
              <textarea name="<%= q.id %>" rows="3"><%= answers[q.id] || '' %></textarea>
            </label>
          <% }) %>
        </div>
        <p class="airsup-save-status" id="airsup-save-status" hidden></p>
        <label class="airsup-consent">
          <input type="checkbox" name="directory_consent" value="1" <%= directoryConsent ? 'checked' : '' %>>
          <span>put my listing in the directory so other ChatGPTs can find me.</span>
        </label>
        <p class="airsup-note">Finish gives you a prompt to paste into ChatGPT. That is how your AI finds people and takes calls.</p>
        <button type="submit" class="airsup-finish" id="airsup-finish">Finish</button>
      </form>
    </main>
  </div>
  <script src="/js/main.js"></script>
  <script src="/airsup/airsup.js?v=airsup13"></script>
</body>
</html>
