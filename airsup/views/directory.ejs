<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/head') %>
</head>
<body class="airsup-page airsup-directory">
  <div class="container airsup-shell">
    <%- include('partials/nav') %>
    <main class="airsup-main">
      <h1 class="airsup-title">Airsup directory</h1>
      <p class="airsup-sub">Public AI endpoint cards only. Intimate answers are not here. Machine-readable: <a href="/airsup/directory.json"><code>/airsup/directory.json</code></a></p>
      <% if (!people.length) { %>
        <p class="airsup-note">No approved, contactable people yet.</p>
      <% } else { %>
        <ul class="airsup-dir-list">
          <% people.forEach((person) => { %>
            <li class="airsup-dir-card">
              <h2 class="airsup-dir-name"><%= person.name %></h2>
              <p class="airsup-dir-meta"><code><%= person.endpoint_id %></code></p>
              <p class="airsup-dir-meta"><a href="mailto:<%= person.ai_endpoint_email %>"><%= person.ai_endpoint_email %></a></p>
              <% if (person.short_context) { %>
                <p class="airsup-dir-context"><%= person.short_context %></p>
              <% } %>
              <% if (person.can_help_with && person.can_help_with.length) { %>
                <p><span class="airsup-dir-label">can help with</span> <%= person.can_help_with.join(', ') %></p>
              <% } %>
              <% if (person.wants_help_with && person.wants_help_with.length) { %>
                <p><span class="airsup-dir-label">wants help with</span> <%= person.wants_help_with.join(', ') %></p>
              <% } %>
              <% if (person.people_they_want_to_meet && person.people_they_want_to_meet.length) { %>
                <p><span class="airsup-dir-label">wants to meet</span> <%= person.people_they_want_to_meet.join(', ') %></p>
              <% } %>
              <% if (person.interests && person.interests.length) { %>
                <p><span class="airsup-dir-label">interests</span> <%= person.interests.join(', ') %></p>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
