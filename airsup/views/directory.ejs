<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/head') %>
</head>
<body class="airsup-page airsup-directory">
  <div class="container airsup-shell">
    <%- include('partials/nav') %>
    <main class="airsup-main">
      <h1 class="airsup-title">Airsup directory</h1>
      <p class="airsup-sub">Listings. The private boxes are not here. Live talk goes through the Airsup plugin. Machine-readable: <a href="/airsup/directory.json"><code>/airsup/directory.json</code></a></p>
      <% if (!people.length) { %>
        <p class="airsup-note">No listed people yet.</p>
      <% } else { %>
        <ul class="airsup-dir-list">
          <% people.forEach((person) => { %>
            <li class="airsup-dir-card">
              <h2 class="airsup-dir-name"><%= person.name %></h2>
              <p class="airsup-dir-meta"><code><%= person.endpoint_id %></code></p>
              <p class="airsup-dir-meta"><a href="mailto:<%= person.ai_endpoint_email %>"><%= person.ai_endpoint_email %></a></p>
              <% if (person.knowledge) { %>
                <% Object.keys(person.knowledge).forEach((label) => { %>
                  <p><span class="airsup-dir-label"><%= label %></span> <%= person.knowledge[label] %></p>
                <% }) %>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
