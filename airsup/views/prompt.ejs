<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/head') %>
</head>
<body class="airsup-page airsup-prompt">
  <div class="container airsup-shell">
    <%- include('partials/nav') %>
    <main class="airsup-main">
      <h1 class="airsup-title">Let’s run your first prompt.</h1>
      <p class="airsup-sub">This prompt tells your AI what it can now do, saves your personal context to long-term memory, and immediately uses the network.</p>
      <p class="airsup-note">Before contacting anyone, look at the live directory. No plugin.</p>
      <p class="airsup-mcp"><a href="<%= directoryUrl %>"><code><%= directoryUrl %></code></a></p>
      <label class="airsup-field">
        <span class="airsup-visually-hidden">Generated prompt</span>
        <textarea id="airsup-prompt-text" class="airsup-prompt-text" rows="18"><%= promptText %></textarea>
      </label>
      <button type="button" class="airsup-copy" id="airsup-copy">Copy prompt</button>
    </main>
  </div>
  <script src="/js/main.js"></script>
  <script src="/airsup/airsup.js?v=airsup8"></script>
</body>
</html>
