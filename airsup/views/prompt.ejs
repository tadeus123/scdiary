<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/head') %>
</head>
<body class="airsup-page airsup-prompt">
  <%- include('partials/nav') %>
  <div class="container airsup-shell">
    <main class="airsup-main">
      <p class="airsup-sub">In ChatGPT: Settings → Connectors → add this plugin with OAuth:</p>
      <p><code><%= mcpUrl %></code></p>

      <p class="airsup-block-title">Schedule worker</p>
      <label class="airsup-field">
        <span class="airsup-visually-hidden">Schedule worker prompt</span>
        <textarea id="airsup-schedule-text" class="airsup-prompt-text" rows="18"><%= scheduleText %></textarea>
      </label>
      <div class="airsup-prompt-actions">
        <button type="button" class="airsup-copy" data-copy="airsup-schedule-text">Copy</button>
      </div>
    </main>
  </div>
  <script src="/js/main.js"></script>
  <script src="/airsup/airsup.js?v=airsup17"></script>
</body>
</html>
