{
  "name": "verify_supplier",
  "title": "Verify supplier",
  "description": "Methods: manual (requires confirm:true + note), email_link (sends mail, no raw link returned), site_listed (email on scraped site → verified). dns/website_token not built. Resolve by company_id or exact domain.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "method": {
        "type": "string",
        "enum": ["manual", "email_link", "site_listed", "dns", "website_token"]
      },
      "company_id": { "type": "string" },
      "domain": { "type": "string" },
      "email": { "type": "string" },
      "note": { "type": "string" },
      "confirm": { "type": "boolean" },
      "lang": { "type": "string", "enum": ["zh", "en"] }
    },
    "required": ["method"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  }
}
