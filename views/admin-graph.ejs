<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="stylesheet" href="/css/style.css?v=graph1">
</head>
<body class="admin-page admin-graph-page">
  <a href="/admin" class="corner-btn-left" aria-label="Back to Admin"></a>

  <div class="container">
    <nav>
      <div class="nav-left">
        <span class="site-title">graph</span>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">
          <svg class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="6.5" x2="12" y2="3"></line>
            <line x1="17.5" y1="12" x2="21" y2="12"></line>
            <line x1="12" y1="17.5" x2="12" y2="21"></line>
            <line x1="6.5" y1="12" x2="3" y2="12"></line>
            <line x1="16.96" y1="7.04" x2="19.07" y2="4.93"></line>
            <line x1="16.96" y1="16.96" x2="19.07" y2="19.07"></line>
            <line x1="7.04" y1="16.96" x2="4.93" y2="19.07"></line>
            <line x1="7.04" y1="7.04" x2="4.93" y2="4.93"></line>
          </svg>
        </button>
      </div>
    </nav>

    <div class="add-book-section">
      <h2 id="people-form-title">add a person</h2>
      <form id="people-form" class="book-form" enctype="multipart/form-data">
        <input type="hidden" id="people-edit-id" value="">
        <div class="form-group">
          <label for="people-name">name</label>
          <input type="text" id="people-name" name="name" required autocomplete="off">
        </div>
        <div class="form-group">
          <label for="people-photo">picture</label>
          <input type="file" id="people-photo" name="photo" accept="image/*">
          <div id="people-photo-preview" class="cover-preview people-photo-preview hidden">
            <img id="people-preview-img" src="" alt="Photo preview">
          </div>
        </div>
        <div class="form-group">
          <label for="people-description">what they got done</label>
          <textarea id="people-description" name="description" rows="4" placeholder="a short note on what they built or did..."></textarea>
        </div>
        <div class="form-group">
          <label for="people-from">comes from</label>
          <select id="people-from" name="from_id">
            <option value="">new starting node</option>
          </select>
        </div>
        <div class="people-form-actions">
          <button type="submit" class="btn" id="people-save-btn">add</button>
          <button type="button" class="btn btn-secondary hidden" id="people-cancel-btn">cancel</button>
        </div>
        <div id="people-form-message" class="form-message"></div>
      </form>
    </div>

    <div class="connection-section">
      <h2>people</h2>
      <div id="people-list" class="people-admin-list"></div>
      <div id="people-empty" class="empty-state hidden">
        <p>no people yet. add a starting node above.</p>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/admin-graph.js?v=graph1"></script>
</body>
</html>
