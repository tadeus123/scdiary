<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <%- include('partials/seo-head') %>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="corner-page admin-corner-page">
  <a href="/admin" class="corner-btn-left" aria-label="Back to Admin"></a>

  <div class="selfie-wall" aria-label="Selfie wall admin — years 1 to 100">
    <div class="selfie-wall-grid">
      <% for (let i = 1; i <= 100; i++) { %>
        <div class="selfie-tile" data-year="<%= i %>" role="button" tabindex="0" aria-label="Upload selfie for year <%= i %>">
          <span class="selfie-tile-number"><%= i %></span>
          <button type="button" class="selfie-tile-delete" aria-label="Delete year <%= i %> selfie" hidden>×</button>
        </div>
      <% } %>
    </div>
  </div>

  <input type="file" id="selfie-file-input" accept="image/jpeg,image/png,image/gif,image/webp" hidden>

  <div id="selfie-crop-modal" class="selfie-crop-modal" hidden>
    <div class="selfie-crop-sheet" role="dialog" aria-modal="true" aria-labelledby="selfie-crop-title">
      <div class="selfie-crop-header">
        <h2 id="selfie-crop-title">Crop year <span id="selfie-crop-year">1</span></h2>
        <p class="selfie-crop-hint">Drag to move · pinch or slider to zoom</p>
      </div>

      <div class="selfie-crop-stage">
        <div class="selfie-crop-viewport" id="selfie-crop-viewport">
          <img id="selfie-crop-image" alt="" draggable="false">
        </div>
      </div>

      <div class="selfie-crop-zoom">
        <button type="button" id="selfie-crop-zoom-out" class="selfie-crop-zoom-btn" aria-label="Zoom out">−</button>
        <input type="range" id="selfie-crop-zoom" class="selfie-crop-zoom-range" min="1" max="4" step="0.01" value="1" aria-label="Zoom">
        <button type="button" id="selfie-crop-zoom-in" class="selfie-crop-zoom-btn" aria-label="Zoom in">+</button>
      </div>

      <div class="selfie-crop-actions">
        <button type="button" id="selfie-crop-cancel" class="selfie-crop-btn selfie-crop-btn-secondary">Cancel</button>
        <button type="button" id="selfie-crop-confirm" class="selfie-crop-btn selfie-crop-btn-primary">Use photo</button>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/admin-corner.js"></script>
</body>
</html>
