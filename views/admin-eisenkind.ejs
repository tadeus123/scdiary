<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/eisenkind/css/a4.css">
</head>
<body>
  <a href="/admin" class="corner-btn-left" aria-label="Back to Admin"></a>

  <div class="container">
    <nav>
      <div class="nav-left">
        <span class="site-title">eisenkind</span>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">
          <svg class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="6.5" x2="12" y2="3"></line>
            <line x1="17.5" y1="12" x2="21" y2="12"></line>
            <line x1="12" y1="17.5" x2="12" y2="21"></line>
            <line x1="6.5" y1="12" x2="3" y2="12"></line>
            <line x1="16.96" y1="7.04" x2="19.07" y2="4.93"></line>
            <line x1="16.96" y1="16.96" x2="19.07" y2="19.07"></line>
            <line x1="7.04" y1="16.96" x2="4.93" y2="19.07"></line>
            <line x1="7.04" y1="7.04" x2="4.93" y2="4.93"></line>
          </svg>
        </button>
      </div>
      <div class="nav-right">
        <span id="save-status" class="eisenkind-save-status" aria-live="polite"></span>
      </div>
    </nav>

    <main>
      <div class="new-entry-box">
        <textarea
          id="eisenkind-story-input"
          placeholder="paste or write the story here…"
          spellcheck="true"
          autofocus
        ><%= notes.story %></textarea>
        <button type="button" class="btn" id="save-btn">save</button>
      </div>

      <article class="eisenkind-admin-preview">
        <div id="eisenkind-story-preview" class="eisenkind-story-text"></div>
      </article>

      <div class="add-book-section kind-hours-admin">
        <h2>kind hours</h2>
        <form id="kind-hours-form" class="book-form">
          <div class="form-group">
            <label for="kindHours">Hours</label>
            <input type="number" id="kindHours" name="hours" min="0.01" step="0.01" placeholder="e.g. 2.5" required>
          </div>

          <div class="form-group">
            <label for="kindDateLogged">Date</label>
            <input type="date" id="kindDateLogged" name="dateLogged" required>
          </div>

          <button type="submit" class="btn">Add Hours</button>
          <div id="kind-hours-message" class="form-message"></div>
        </form>

        <div id="kind-hours-list" class="kind-hours-list">
          <% const sortedHours = (kindHours || []).slice().sort((a, b) => {
            const da = new Date(a.date_logged) - new Date(b.date_logged);
            if (da !== 0) return -da;
            return new Date(b.created_at || 0) - new Date(a.created_at || 0);
          }); %>
          <% if (sortedHours.length === 0) { %>
            <p class="kind-hours-empty">no hours logged yet.</p>
          <% } else { %>
            <% sortedHours.forEach(entry => { %>
              <div class="kind-hours-row" data-id="<%= entry.id %>">
                <span class="kind-hours-row-meta">
                  <%= Number(entry.hours) %> hour<%= Number(entry.hours) === 1 ? '' : 's' %>
                  ·
                  <%= new Date(String(entry.date_logged).includes('T') ? entry.date_logged : entry.date_logged + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </span>
                <button type="button" class="btn btn-secondary kind-hours-delete" data-id="<%= entry.id %>">delete</button>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/admin-eisenkind.js"></script>
</body>
</html>
