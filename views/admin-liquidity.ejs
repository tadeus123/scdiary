<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <%- include('partials/seo-head') %>
  <link rel="stylesheet" href="/css/style.css?v=lq-tight-rows">
</head>
<body class="admin-page admin-liquidity-page">
  <a href="/admin" class="corner-btn-left" aria-label="Back to Admin"></a>

  <div class="container">
    <nav>
      <div class="nav-left">
        <span class="site-title">liquidity</span>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">
          <svg class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="6.5" x2="12" y2="3"></line>
            <line x1="17.5" y1="12" x2="21" y2="12"></line>
            <line x1="12" y1="17.5" x2="12" y2="21"></line>
            <line x1="6.5" y1="12" x2="3" y2="12"></line>
            <line x1="16.96" y1="7.04" x2="19.07" y2="4.93"></line>
            <line x1="16.96" y1="16.96" x2="19.07" y2="19.07"></line>
            <line x1="7.04" y1="16.96" x2="4.93" y2="19.07"></line>
            <line x1="7.04" y1="7.04" x2="4.93" y2="4.93"></line>
          </svg>
        </button>
      </div>
    </nav>

    <main>
      <div class="new-entry-box">
        <h2>log</h2>
        <div id="message-container"></div>
        <div class="liquidity-form-row">
          <div class="form-group">
            <label for="entry-amount">amount</label>
            <input type="text" id="entry-amount" inputmode="decimal" placeholder="-25.32" autocomplete="off" autocapitalize="off" spellcheck="false">
          </div>
          <div class="form-group">
            <span class="liquidity-field-label">currency</span>
            <div class="liquidity-pills" data-target="entry-currency" role="group" aria-label="currency">
              <button type="button" class="liquidity-pill is-active" data-value="USD">USD</button>
              <button type="button" class="liquidity-pill" data-value="EUR">EUR</button>
            </div>
            <input type="hidden" id="entry-currency" value="USD">
          </div>
        </div>
        <textarea id="entry-content" placeholder="what was this..."></textarea>
        <button type="button" class="btn" id="save-btn">save</button>
      </div>

      <div class="entries">
        <% if (!entries || entries.length === 0) { %>
          <div class="empty-state">
            <p>no movements yet. log the first one above.</p>
          </div>
        <% } else { %>
          <% entries.forEach(entry => { %>
            <article class="entry" data-entry-id="<%= entry.id %>">
              <div class="entry-header">
                <div class="entry-date">
                  <%= new Date(entry.timestamp).toLocaleString('en-US', {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: 'numeric',
                    minute: '2-digit'
                  }) %>
                </div>
                <button type="button" class="delete-entry-btn" onclick="deleteLiquidityEntry('<%= entry.id %>')" aria-label="Delete entry">×</button>
              </div>
              <div class="entry-content">
                <% const usd = Number(entry.amount_usd); %>
                <p class="liquidity-amount <%= usd < 0 ? 'liquidity-out' : 'liquidity-in' %>">
                  <%= usd < 0 ? '−' : '+' %>$<%= Math.abs(usd).toFixed(2) %>
                </p>
                <% if (entry.note) { %>
                  <p><%= entry.note %></p>
                <% } %>
                <% if (entry.recurring_id) { %>
                  <p class="form-hint">monthly</p>
                <% } %>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>

      <div class="new-entry-box liquidity-start-box">
        <h2>liabilities</h2>
        <div id="liability-message"></div>
        <div class="liquidity-form-row">
          <div class="form-group">
            <label for="liability-amount">amount</label>
            <input type="text" id="liability-amount" inputmode="decimal" placeholder="-25.32" autocomplete="off" autocapitalize="off" spellcheck="false">
          </div>
          <div class="form-group">
            <span class="liquidity-field-label">currency</span>
            <div class="liquidity-pills" data-target="liability-currency" role="group" aria-label="currency">
              <button type="button" class="liquidity-pill is-active" data-value="USD">USD</button>
              <button type="button" class="liquidity-pill" data-value="EUR">EUR</button>
            </div>
            <input type="hidden" id="liability-currency" value="USD">
          </div>
        </div>
        <textarea id="liability-name" placeholder="mom's flight, the 1.5k thing..."></textarea>
        <button type="button" class="btn" id="save-liability-btn">add liability</button>
        <% const openUsd = (liabilities || []).reduce((sum, item) => sum + Math.abs(Number(item.amount_usd) || 0), 0); %>
        <p class="liquidity-open-total">open: −$<%= openUsd.toFixed(2) %></p>

        <% if (liabilities && liabilities.length > 0) { %>
          <div class="entries liquidity-liability-list">
            <% liabilities.forEach(item => { %>
              <article class="entry" data-liability-id="<%= item.id %>">
                <div class="entry-header">
                  <div class="entry-date"><%= item.name %></div>
                  <div class="liquidity-entry-actions">
                    <button type="button" class="liquidity-paid-btn" onclick="payLiquidityLiability('<%= item.id %>')">paid</button>
                    <button type="button" class="delete-entry-btn" onclick="deleteLiquidityLiability('<%= item.id %>')" aria-label="Delete liability">×</button>
                  </div>
                </div>
                <div class="entry-content">
                  <p class="liquidity-amount liquidity-out">−$<%= Math.abs(Number(item.amount_usd)).toFixed(2) %></p>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="add-book-section liquidity-monthly-section">
        <h2>monthly</h2>
        <div id="recurring-message"></div>
        <form id="recurring-form" class="book-form">
          <div class="liquidity-form-row">
            <div class="form-group">
              <label for="recurring-name">name</label>
              <input type="text" id="recurring-name" placeholder="rent, salary, …" required autocomplete="off">
            </div>
            <div class="form-group">
              <label for="recurring-amount">amount</label>
              <input type="text" id="recurring-amount" inputmode="decimal" placeholder="-25.32" autocomplete="off" autocapitalize="off" spellcheck="false" required>
            </div>
            <div class="form-group">
              <span class="liquidity-field-label">currency</span>
              <div class="liquidity-pills" data-target="recurring-currency" role="group" aria-label="currency">
                <button type="button" class="liquidity-pill is-active" data-value="USD">USD</button>
                <button type="button" class="liquidity-pill" data-value="EUR">EUR</button>
              </div>
              <input type="hidden" id="recurring-currency" value="USD">
            </div>
            <div class="form-group">
              <label for="recurring-day">day of month</label>
              <input type="number" id="recurring-day" min="1" max="31" value="1" required inputmode="numeric">
            </div>
          </div>
          <button type="submit" class="btn" id="save-recurring-btn">add monthly</button>
        </form>

        <% if (recurring && recurring.length > 0) { %>
          <div class="entries liquidity-recurring-list">
            <% recurring.forEach(item => { %>
              <article class="entry" data-recurring-id="<%= item.id %>">
                <div class="entry-header">
                  <div class="entry-date"><%= item.name %></div>
                  <button type="button" class="delete-entry-btn" onclick="deleteLiquidityRecurring('<%= item.id %>')" aria-label="Delete monthly">×</button>
                </div>
                <div class="entry-content">
                  <p class="liquidity-amount <%= item.direction === 'out' ? 'liquidity-out' : 'liquidity-in' %>">
                    <%= item.direction === 'out' ? '−' : '+' %><%= Number(item.amount).toFixed(2) %> <%= item.currency %>
                  </p>
                  <p class="form-hint">day <%= item.day_of_month %><%= item.end_date ? ` · until ${item.end_date}` : '' %></p>
                </div>
              </article>
            <% }) %>
          </div>
          <p class="liquidity-runway"><%= runway && runway.label ? runway.label : 'cash runway: —' %></p>
        <% } %>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/admin-liquidity.js?v=lq-no-start"></script>
</body>
</html>
