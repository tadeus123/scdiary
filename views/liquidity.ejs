<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <%- include('partials/seo-head') %>
  <link rel="stylesheet" href="/css/style.css?v=lq-tooltip5">
</head>
<body class="liquidity-page">
  <nav class="bookshelf-header liquidity-header">
    <div class="nav-left">
      <a href="/liquidity" class="site-title">liquidity</a>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">
        <svg class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="6.5" x2="12" y2="3"></line>
          <line x1="17.5" y1="12" x2="21" y2="12"></line>
          <line x1="12" y1="17.5" x2="12" y2="21"></line>
          <line x1="6.5" y1="12" x2="3" y2="12"></line>
          <line x1="16.96" y1="7.04" x2="19.07" y2="4.93"></line>
          <line x1="16.96" y1="16.96" x2="19.07" y2="19.07"></line>
          <line x1="7.04" y1="16.96" x2="4.93" y2="19.07"></line>
          <line x1="7.04" y1="7.04" x2="4.93" y2="4.93"></line>
        </svg>
      </button>
    </div>
    <button type="button" id="liquidity-monthly-toggle" class="liquidity-monthly-toggle" aria-expanded="false" aria-controls="liquidity-monthly-overlay">monthly</button>
  </nav>

  <div id="liquidity-chart"></div>
  <div id="liquidity-balance" class="reading-time-summary"></div>
  <div id="liquidity-monthly-overlay" class="liquidity-monthly-overlay hidden">
    <div class="liquidity-monthly-sheet" role="dialog" aria-modal="true" aria-labelledby="liquidity-monthly-title">
      <button type="button" class="liquidity-monthly-close" id="liquidity-monthly-close" aria-label="Close">×</button>
      <h2 id="liquidity-monthly-title">monthly</h2>
      <div id="liquidity-monthly-list"></div>
      <div id="liquidity-monthly-totals"></div>
    </div>
  </div>
  <div id="liquidity-tooltip" class="liquidity-tooltip hidden"></div>

  <script src="/js/main.js"></script>
  <script src="/js/liquidity.js?v=lq-same-stick"></script>
</body>
</html>
