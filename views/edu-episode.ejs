<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/seo-head') %>
  <link rel="stylesheet" href="/css/style.css?v=edu16">
</head>
<body class="edu-page edu-now">
  <a href="/" class="corner-btn-left" aria-label="Back to Diary"></a>

  <div class="container">
    <nav>
      <div class="nav-left">
        <a href="/edu" class="site-title">edu</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
          <svg class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="6.5" x2="12" y2="3"></line>
            <line x1="17.5" y1="12" x2="21" y2="12"></line>
            <line x1="12" y1="17.5" x2="12" y2="21"></line>
            <line x1="6.5" y1="12" x2="3" y2="12"></line>
            <line x1="16.96" y1="7.04" x2="19.07" y2="4.93"></line>
            <line x1="16.96" y1="16.96" x2="19.07" y2="19.07"></line>
            <line x1="7.04" y1="16.96" x2="4.93" y2="19.07"></line>
            <line x1="7.04" y1="7.04" x2="4.93" y2="4.93"></line>
          </svg>
        </button>
      </div>
    </nav>

    <main>
      <article class="edu-now-card" data-episode-id="<%= episode.id %>">
        <div class="edu-now-hero">
          <img
            class="edu-now-cover"
            src="<%= episode.image %>"
            alt="<%= episode.name %>"
            width="800"
            height="800"
            data-action="play"
          >
          <h1 class="edu-name"><%= episode.name %></h1>
          <p class="edu-born">born: <%= episode.born %></p>
          <%- include('partials/edu-player') %>
        </div>
        <div class="edu-now-copy">
          <p class="edu-bio"><%= episode.bio %></p>
          <% if (links && links.length) { %>
            <div class="edu-links">
              <% links.forEach((link) => { %>
                <a class="edu-link" href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a>
              <% }) %>
            </div>
          <% } %>
          <% if (episode.transcript && episode.transcript.length) { %>
            <details class="edu-transcript is-current">
              <summary class="edu-transcript-label">transcript</summary>
              <div class="edu-transcript-body">
                <% episode.transcript.forEach((para) => { %>
                  <p><%= para %></p>
                <% }) %>
              </div>
            </details>
          <% } %>
        </div>
      </article>
    </main>
  </div>

  <audio
    id="edu-audio"
    class="edu-audio"
    preload="metadata"
    playsinline
    webkit-playsinline
  ></audio>

  <script>window.EDU_EPISODES = <%- JSON.stringify([episode]) %>;</script>
  <script src="/js/main.js"></script>
  <script src="/js/edu.js?v=edu16"></script>
</body>
</html>
