<h1>liquidity</h1>
<% if (fetchView) { %>
  <p>now: <%= fetchView.now %></p>
  <p>bank: <%= fetchView.bank %></p>
  <p>cash: <%= fetchView.cash %></p>
  <p>open: <%= fetchView.open %></p>
  <p><%= fetchView.runway %></p>
  <h2>monthly</h2>
  <% if (!fetchView.monthly.length) { %>
    <p>no monthly expenses yet</p>
  <% } else { %>
    <ul>
      <% fetchView.monthly.forEach((item) => { %>
        <li><%= item.name %> — day <%= item.day %> — <%= item.amount %></li>
      <% }) %>
    </ul>
  <% } %>
  <p>total monthly lost money: <%= fetchView.monthlyTotal %></p>
  <h2>transactions</h2>
  <% if (!fetchView.transactions.length) { %>
    <p>no transactions yet</p>
  <% } else { %>
    <ul>
      <% fetchView.transactions.forEach((row) => { %>
        <li><%= row.day %> <%= row.amount %><% if (row.note) { %> <%= row.note %><% } %><% if (row.account === 'cash') { %> cash<% } %></li>
      <% }) %>
    </ul>
  <% } %>
  <% if (fetchView.pending.length) { %>
    <h2>pending</h2>
    <ul>
      <% fetchView.pending.forEach((row) => { %>
        <li><%= row.day %> <%= row.amount %><% if (row.note) { %> <%= row.note %><% } %></li>
      <% }) %>
    </ul>
  <% } %>
  <% if (fetchView.liabilities.length) { %>
    <h2>open liabilities</h2>
    <ul>
      <% fetchView.liabilities.forEach((row) => { %>
        <li><%= row.day %> <%= row.amount %> <%= row.note %></li>
      <% }) %>
    </ul>
  <% } %>
<% } %>
