<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <%- include('partials/seo-head') %>
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Prerender entire bookshelf page for instant loading -->
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="dns-prefetch" href="https://unpkg.com">
  <link rel="prerender" href="/bookshelf">
</head>
<body class="corner-page">
  <a href="/" class="corner-btn-left" aria-label="Back to Diary"></a>
  <a href="/bookshelf" class="bookshelf-text">show me your bookshelf and I know who you are...</a>
  
  <div class="selfie-wall" aria-label="Selfie wall — Lebensjahre 0 to 99">
    <div class="selfie-wall-grid">
      <% for (let i = 0; i <= 99; i++) { %>
        <div class="selfie-tile" data-year="<%= i %>">
          <span class="selfie-tile-number"><%= i %></span>
        </div>
      <% } %>
    </div>
  </div>

  <div id="selfie-lightbox" class="selfie-lightbox" hidden>
    <button type="button" class="selfie-lightbox-close" id="selfie-lightbox-close" aria-label="Close">×</button>
    <figure class="selfie-lightbox-figure">
      <img id="selfie-lightbox-image" class="selfie-lightbox-image" alt="">
      <figcaption id="selfie-lightbox-caption" class="selfie-lightbox-caption"></figcaption>
    </figure>
  </div>
  
  <script src="/js/main.js"></script>
  <script src="/js/corner.js"></script>
  
  <!-- Speculation Rules API for instant navigation -->
  <script type="speculationrules">
    {
      "prerender": [
        {
          "source": "list",
          "urls": ["/bookshelf"]
        }
      ]
    }
  </script>
  
  <!-- Aggressive prefetch for instant bookshelf loading -->
  <script>
    (function() {
      // Store prefetched data globally so bookshelf.js can use it
      window.__prefetchedBookshelfData__ = null;
      window.__prefetchedReadingTime__ = null;
      
      // Start prefetching immediately after page loads
      window.addEventListener('load', async () => {
        try {
          // Prefetch books data and store it
          const booksResponse = await fetch(`/api/books?t=${Date.now()}`);
          if (booksResponse.ok) {
            const data = await booksResponse.json();
            window.__prefetchedBookshelfData__ = data;
            
            // Preload book cover images
            if (data.success && data.books) {
              data.books.forEach(book => {
                if (book.cover_image_url) {
                  const img = new Image();
                  img.src = book.cover_image_url;
                }
              });
            }
          }
          
          // Prefetch reading time
          const readingTimeResponse = await fetch(`/api/books/total-reading-time?t=${Date.now()}`);
          if (readingTimeResponse.ok) {
            window.__prefetchedReadingTime__ = await readingTimeResponse.json();
          }
          
          console.log('Bookshelf fully preloaded - click will be instant!');
        } catch (error) {
          console.log('Prefetch failed, will load normally');
        }
      });
    })();
  </script>
</body>
</html>
