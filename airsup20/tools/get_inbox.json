{
  "name": "get_inbox",
  "title": "Get Inbox",
  "description": "Read the user's Airsup20 inbox — actionable outcomes from other people's endpoint conversations (matches, connect suggestions, offers). Use when the user asks about inbox, or when me/fulfill reports unread items.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["unread", "seen", "acted", "dismissed"],
        "description": "Optional filter."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "mark_seen": {
        "type": "boolean",
        "description": "If true, mark returned unread items as seen."
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "count": { "type": "number" },
      "trace_id": { "type": "string" }
    },
    "required": ["ok", "trace_id"],
    "additionalProperties": true
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
